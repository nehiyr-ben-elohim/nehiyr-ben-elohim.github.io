---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import { SITE_NAME } from '../lib/site'
import '../styles/main.scss'

interface Props {
  title: string
  description?: string
  image?: ImageMetadata
  bodyClass?: string
}

const {
  title,
  description = 'Jean-jacques AKAKPO, développeur web et mobile. Portfolio, réalisations et contact.',
  image,
  bodyClass,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = image ? new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, Astro.site) : undefined
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <noscript>
      <style>
        [data-scrollbreak], [data-scrollbreak] *, .project-item, .project-item *, .content-header-title, .content-header-title * {
          opacity: 1 !important;
          visibility: visible !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      import '../scripts/lifecycle'
    </script>
  </body>
</html>
