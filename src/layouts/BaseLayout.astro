---
import type { ImageMetadata } from 'astro'
import { ClientRouter } from 'astro:transitions'
import SeoHead from '../components/SeoHead.astro'
import { SITE_NAME } from '../lib/site'
import '../styles/main.scss'

interface Props {
  title: string
  description?: string
  image?: ImageMetadata
  bodyClass?: string
}

const {
  title,
  description = 'Jean-jacques AKAKPO, développeur web et mobile. Portfolio, réalisations et contact.',
  image,
  bodyClass,
} = Astro.props
---

<html lang="fr">
  <head>
    <SeoHead title={title} description={description} siteName={SITE_NAME} image={image} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <noscript>
      <style>
        [data-scrollbreak], [data-scrollbreak] *, .project-item, .project-item *, .content-header-title, .content-header-title * {
          opacity: 1 !important;
          visibility: visible !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      import '../scripts/lifecycle'
    </script>
  </body>
</html>
