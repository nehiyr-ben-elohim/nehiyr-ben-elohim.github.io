---
import type { ImageMetadata } from 'astro'
import { ClientRouter } from 'astro:transitions'
import SeoHead from '../components/SeoHead.astro'
import { OWNER } from '../lib/site'
import '../styles/site.css'

interface Props {
  title: string
  description: string
  // reading progress in the top bar
  progress?: boolean
  image?: ImageMetadata
  ogTitle?: string
  ogDescription?: string
  jsonLd?: Record<string, unknown>
}

const { title, description, progress = false, image, ogTitle, ogDescription, jsonLd } = Astro.props
---

<html lang="fr">
  <head>
    <SeoHead title={title} description={description} siteName={OWNER} image={image} ogTitle={ogTitle} ogDescription={ogDescription} jsonLd={jsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@700&family=Public+Sans:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400&display=swap"
    />
    <noscript>
      <style>
        [data-js-only] { display: none !important; }
        [data-exp-body][hidden] { display: flex !important; }
        [data-skills] .skill-group.extra { display: flex !important; }
      </style>
    </noscript>
    <ClientRouter />
  </head>
  <body>
    {progress && <div class="top-bar" aria-hidden="true"><div class="progress" data-progress></div></div>}
    <slot />
    <script>
      import '../scripts/lifecycle'
    </script>
  </body>
</html>

<style is:global>
  html, body { overflow-x: clip; }
</style>
