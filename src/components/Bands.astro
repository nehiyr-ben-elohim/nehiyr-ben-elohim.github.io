---
import { deviconSrc } from '../lib/devicons'
import type { Profile } from '../lib/profile'

interface Props {
  marquee: Profile['marquee']
}

// content repeated so the loop never shows a gap (keywords ×3, tech ×2)
const { marquee } = Astro.props
const keywords = [...marquee.keywords, ...marquee.keywords, ...marquee.keywords]
const tech = [...marquee.tech, ...marquee.tech]
---

<div class="bands" aria-hidden="true" data-bands>
  <div class="band dark">
    <div class="track" data-marquee="right">
      {keywords.map(k => <span class="keyword"><span class="slashes">//</span>{k}</span>)}
    </div>
  </div>
  <div class="band light">
    <div class="track" data-marquee="left">
      {tech.map(t => (
        <span class="chip">
          <span class="chip-icon"><img src={deviconSrc(t.icon)} alt="" width="26" height="26" loading="lazy" /></span>{t.name}
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .bands { position: relative; overflow: hidden; padding: 46px 0 52px; margin: 8px 0; }
  .band { overflow: hidden; border-top: 3px solid var(--cs-ink); border-bottom: 3px solid var(--cs-ink); padding: 14px 0; }
  .dark {
    position: absolute;
    left: -5%;
    right: -5%;
    top: 50%;
    transform: translateY(-50%) rotate(2.2deg);
    background: var(--cs-ink);
    color: var(--cs-accent);
  }
  .light { position: relative; margin: 0 -5%; transform: rotate(-2deg); background: var(--cs-accent); }
  .track { display: flex; width: max-content; white-space: nowrap; }
  .dark .track {
    gap: 22px;
    font-family: var(--cs-mono);
    font-weight: 700;
    font-size: clamp(15px, 1.4vw, 18px);
    text-transform: lowercase;
  }
  .keyword { display: flex; align-items: center; gap: 22px; }
  .slashes { color: #8a8a8a; }
  .light .track {
    gap: 18px;
    padding-left: 18px;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: clamp(17px, 1.6vw, 21px);
    color: var(--cs-ink);
  }
  .chip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 18px 8px 8px;
    background: #fff;
    border: 2px solid var(--cs-ink);
    box-shadow: 3px 3px 0 var(--cs-ink);
  }
  .chip-icon { width: 34px; height: 34px; display: grid; place-items: center; background: #fff; }
  .chip-icon img { display: block; width: 26px; height: 26px; object-fit: contain; }
</style>
