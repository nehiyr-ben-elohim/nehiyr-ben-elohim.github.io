---
import type { Profile } from '../lib/profile'

interface Props {
  notes: Profile['notes']
  label: string
}

const { notes, label } = Astro.props
const upcoming = notes.every(n => n.soon)
---

<section id="notes" data-section={label} class="notes">
  <div class="container inner">
    <div data-reveal class="head">
      <h2 class="section-title">Ce que j’apprends en chemin</h2>
      {upcoming && <p class="lead">Trois notes techniques en cours d’écriture.</p>}
    </div>
    <div class="list">
      {notes.map(n => (
        <article data-reveal>
          <h3>{n.href ? <a href={n.href}>{n.title}</a> : n.title}</h3>
          <p class="meta"><span class="tag">{n.tag}</span><span>{n.read} de lecture{n.soon && ', bientôt'}</span></p>
          <p class="text">{n.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .inner { padding-block: var(--section-gap-l); display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-2xl) var(--gap-columns); align-items: start; }
  .head { display: flex; flex-direction: column; gap: var(--space-md); }
  .head .lead { color: var(--color-ink-2); }
  .list { border-top: 2px solid var(--color-ink); }
  article {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-sm) var(--gap-columns);
    align-items: baseline;
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .meta { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2xs); font-size: var(--text-sm); color: var(--color-muted); }
  .text { color: var(--color-ink-2); }
  @media (max-width: 60rem) {
    .inner, article { grid-template-columns: minmax(0, 1fr); }
  }
</style>
