---
import { deviconSrc } from '../lib/devicons'
import type { Profile } from '../lib/profile'

interface Props {
  skills: Profile['skills']
  label: string
}

const { skills, label } = Astro.props
// mobile shows the first groups only, until "voir toutes"
const MOBILE_GROUPS = 3
---

<section id="competences" data-section={label} class="skills" data-skills>
  <div class="container inner">
    <div data-reveal class="head">
      <h2 class="section-title">Ma boîte à outils</h2>
      <p class="lead">Ce que j’utilise au quotidien, par domaine.</p>
    </div>
    <div class="list">
      {skills.map((g, i) => (
        <div data-reveal class:list={['skill-group', { extra: i >= MOBILE_GROUPS }]}>
          <h3>{g.cat} <span class="count">{String(g.items.length).padStart(2, '0')}</span></h3>
          <ul>
            {g.items.map(s => (
              <li><img src={deviconSrc(s.icon)} alt="" width="24" height="24" loading="lazy" />{s.name}</li>
            ))}
          </ul>
        </div>
      ))}
      <button type="button" class="more text-link" data-skills-more data-js-only>voir toutes les compétences</button>
    </div>
  </div>
</section>

<style>
  .inner { padding-block: var(--section-gap-l) var(--section-gap); display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-2xl) var(--gap-columns); align-items: start; }
  .head { display: flex; flex-direction: column; gap: var(--space-md); }
  .head .lead { color: var(--color-ink-2); }
  .list { min-width: 0; display: flex; flex-direction: column; border-top: 2px solid var(--color-ink); }
  .skill-group {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--space-sm) var(--gap-columns);
    align-items: baseline;
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  h3 { font-size: var(--text-title); }
  .count { font: 400 var(--text-sm)/1 var(--font-body); color: var(--color-muted); font-variant-numeric: tabular-nums; letter-spacing: 0; }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-lg); }
  li { display: inline-flex; align-items: center; gap: var(--space-xs); font-size: var(--text-md); }
  li img { flex-shrink: 0; object-fit: contain; }
  .more { white-space: nowrap; align-self: flex-start; margin-top: var(--space-md); padding: 0; border: 0; background: none; color: var(--color-ink); cursor: pointer; }
  @media (max-width: 60rem) {
    .inner { grid-template-columns: minmax(0, 1fr); }
    .skill-group { grid-template-columns: minmax(0, 1fr); }
    .skills:not([data-all]) .extra { display: none; }
    .skills[data-all] .more { display: none; }
  }
  @media (min-width: 60.0625rem) {
    .more { display: none; }
  }
</style>
