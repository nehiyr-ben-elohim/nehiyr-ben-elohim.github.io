---
import { existsSync } from 'node:fs'
import ShadowButton from './ShadowButton.astro'
import type { Profile } from '../lib/profile'

interface Props {
  experience: Profile['experience']
  label: string
}

const { experience, label } = Astro.props
const since = experience.at(-1)?.year
// the CV is only linked once the file has been added
const CV = '/cv/Resume-Justin-Potchona.pdf'
const hasCv = existsSync(`public${CV}`)
// dates read as a span, not a dash
const span = (s: string) => s.replace(/\s*–\s*/g, ' à ')
---

<section id="parcours" data-section={label} class="experience on-night">
  <div class="container inner">
    <div data-reveal class="aside">
      <h2 class="section-title">Six ans, quatre équipes</h2>
      <p class="intro">Entre agences, startups et missions freelance, en France et en Afrique de l’Ouest.</p>
      <dl class="stats">
        <div><dt>Entreprises</dt><dd class="exp-count">{String(experience.length).padStart(2, '0')}</dd></div>
        <div><dt>Depuis</dt><dd>{since}</dd></div>
      </dl>
      <button type="button" class="all-toggle" data-exp-all data-js-only>tout déplier ↓</button>
      {hasCv && <ShadowButton href={CV} external>télécharger mon CV</ShadowButton>}
    </div>

    <ol class="timeline">
      {experience.map((x, i) => {
        const bodyId = `exp-body-${i}`
        const Logo = x.url ? 'a' : 'span'
        return (
          <li data-reveal class:list={{ current: x.current }}>
            <div class="head">
              <Logo
                class="company-logo"
                {...(x.url ? { href: x.url, target: '_blank', rel: 'noopener noreferrer', 'aria-label': x.company } : { 'aria-hidden': 'true' })}
              >
                {x.logo ? (
                  <img src={x.logo} alt="" width="32" height="32" loading="lazy" />
                ) : (
                  <span class="mono" style={`background:${x.color}`}>{x.mono}</span>
                )}
              </Logo>
              <div class="who">
                <h3>{x.company}</h3>
                <p class="when">{x.current && <span class="now">en cours</span>}{x.from} à {x.to}, {x.dur}</p>
              </div>
              <button type="button" class="toggle" aria-expanded={i === 0} aria-controls={bodyId} data-exp-toggle data-js-only>
                <span class="toggle-label">{i === 0 ? 'réduire' : 'détails'}</span>
              </button>
            </div>
            <div class="summary">
              <ul class="stages">
                {x.stages.map(st => <li><span class="role">{st.role}</span><span class="stage-when">{span(st.when)}</span></li>)}
              </ul>
              <ul class="chips">{x.chips.map(c => <li>{c}</li>)}</ul>
            </div>
            <div id={bodyId} class="body" data-exp-body hidden={i !== 0}>
              <p>{x.desc}</p>
              <dl class="results">
                {x.results.map(r => <div><dt class="result-k">{r.k}</dt><dd class="result-v">{r.v}</dd></div>)}
              </dl>
              <div class="foot">
                <ul class="tags">{x.tags.map(t => <li class="tag">{t}</li>)}</ul>
                {x.project && <a href={`/projets/${x.project}`} class="text-link project-link">voir l’étude de cas</a>}
              </div>
            </div>
          </li>
        )
      })}
    </ol>
  </div>
</section>

<style>
  .inner {
    padding-block: var(--section-gap);
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-2xl) var(--gap-columns);
    align-items: start;
  }
  .aside { position: sticky; top: var(--space-3xl); display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-lg); }
  .intro { max-width: 34ch; color: var(--color-on-night-2); }
  .stats { margin: 0; display: flex; gap: var(--space-xl); }
  .stats div { display: flex; flex-direction: column-reverse; gap: var(--space-2xs); }
  .stats dt { font-size: var(--text-sm); color: var(--color-on-night-muted); }
  .stats dd { margin: 0; font: var(--display-weight) var(--text-2xl)/1 var(--font-display); font-variant-numeric: tabular-nums; }
  .all-toggle, .toggle {
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 2px solid var(--color-on-night);
    background: transparent;
    color: var(--color-on-night);
    font: var(--display-weight) var(--text-sm)/1 var(--font-display);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
  }
  .all-toggle:hover, .toggle:hover, .toggle[aria-expanded='true'] { background: var(--color-accent); color: var(--color-ink); border-color: var(--color-accent); }
  .all-toggle:active, .toggle:active { background: var(--color-night-2); color: var(--color-on-night); }
  .all-toggle:focus-visible, .toggle:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

  .timeline { margin: 0; padding: 0; list-style: none; border-top: 2px solid var(--color-on-night); }
  .timeline > li { padding-block: var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-night-rule); display: flex; flex-direction: column; gap: var(--space-md); }
  .head { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-md) var(--space-lg); }
  .company-logo {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    background: var(--color-on-night);
    overflow: hidden;
  }
  a.company-logo:hover { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .company-logo img { width: 32px; height: 32px; object-fit: contain; }
  .mono { width: 100%; height: 100%; display: grid; place-items: center; font: var(--display-weight) var(--text-lg)/1 var(--font-display); color: var(--color-on-night); }
  .who { min-width: 0; display: flex; flex-direction: column; gap: var(--space-2xs); }
  h3 { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-sm); font-size: var(--text-title); }
  .now { margin-right: var(--space-xs); padding: 0 var(--space-xs); background: var(--color-accent); color: var(--color-ink); }
  .when { font-size: var(--text-sm); color: var(--color-on-night-muted); }
  .summary { padding-left: calc(52px + var(--space-lg)); display: flex; flex-direction: column; gap: var(--space-sm); }
  .stages, .chips, .tags { margin: 0; padding: 0; list-style: none; }
  .stages { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .stages li { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2xs) var(--space-sm); }
  .role { font-weight: 700; }
  .stage-when { font-size: var(--text-sm); color: var(--color-on-night-muted); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); font-size: var(--text-sm); color: var(--color-on-night-2); }
  .body { padding-left: calc(52px + var(--space-lg)); display: flex; flex-direction: column; gap: var(--space-lg); }
  .body p { max-width: 64ch; color: var(--color-on-night-2); }
  .results { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .results div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-2xs); padding: 0 var(--space-lg); border-left: var(--rule-hair) solid var(--color-night-rule); }
  .results div:first-child { padding-left: 0; border-left: 0; }
  .result-v { margin: 0; font: var(--display-weight) var(--text-2xl)/1 var(--font-display); color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .result-k { font-size: var(--text-sm); color: var(--color-on-night-muted); }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-sm) var(--space-md); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .project-link:hover { color: var(--color-ink); }
  @media (max-width: 60rem) {
    .inner { grid-template-columns: minmax(0, 1fr); }
    .aside { position: static; }
    .summary, .body { padding-left: 0; }
    .results { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); }
    .results div, .results div:first-child { padding: 0; border-left: 0; }
  }
</style>
