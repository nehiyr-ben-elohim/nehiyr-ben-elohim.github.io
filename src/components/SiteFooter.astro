---
import { EMAIL, GITHUB_URL, LINKEDIN_URL, OWNER } from '../lib/site'

interface Props {
  // home: the letter close, a big "hello world!" signed off with the links
  big?: boolean
}

const { big = false } = Astro.props
---

<footer class:list={['site-footer', { big, 'on-night': big }]}>
  <div class="container footer-inner">
    {big && (
      <div class="footer-top">
        <p class="sign-off">
          <span class="footer-hello hello-band">hello world!</span>
          <span class="signature">{OWNER}, depuis Lomé.</span>
        </p>
        <ul class="socials">
          <li><a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="social">LinkedIn</a></li>
          <li><a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="social">GitHub</a></li>
          <li><a href={`mailto:${EMAIL}`} class="social">{EMAIL}</a></li>
        </ul>
      </div>
    )}
    <div class="footer-bottom">
      <p>© 2026 {OWNER}, Lomé, Togo</p>
      <a href="#top" class="to-top text-link">haut de page</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: var(--rule-hair) solid var(--color-ink); }
  .footer-inner { display: flex; flex-direction: column; gap: var(--space-2xl); padding-block: var(--space-lg); }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-sm); font-size: var(--text-sm); color: var(--color-muted); }
  .big { border-top: 0; }
  .big .footer-inner { padding-block: var(--space-3xl) var(--space-lg); }
  .big .footer-bottom { padding-top: var(--space-md); border-top: var(--rule-hair) solid var(--color-night-rule); color: var(--color-on-night-muted); }
  .big .to-top:hover { color: var(--color-ink); }
  .footer-top { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); align-items: end; gap: var(--space-xl) var(--gap-columns); }
  .sign-off { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-lg); }
  .footer-hello { padding: var(--space-2xs) var(--space-xl) var(--space-sm); font: var(--display-weight) clamp(3.5rem, 7vw + 1rem, 8rem)/1 var(--font-display); letter-spacing: var(--tracking-display); }
  .signature { font: var(--display-weight) var(--text-xl)/1.2 var(--font-display); }
  .socials { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; border-top: var(--rule-hair) solid var(--color-night-rule); }
  .social {
    display: flex;
    align-items: center;
    min-height: 52px;
    border-bottom: var(--rule-hair) solid var(--color-night-rule);
    font: var(--display-weight) var(--text-lg)/1.2 var(--font-display);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur-short) var(--ease-out);
  }
  .social:hover { color: var(--color-accent); }
  .social:active { color: var(--color-on-night-2); }
  @media (max-width: 60rem) {
    .footer-top { grid-template-columns: minmax(0, 1fr); }
  }
</style>
