---
import { EMAIL, GITHUB_URL, LINKEDIN_URL, OWNER } from '../lib/site'

interface Props {
  // home: dark footer with the big "hello world!" and social links
  big?: boolean
}

const { big = false } = Astro.props
---

<footer class:list={['site-footer', { big }]}>
  <div class="wrap footer-inner">
    {big && (
      <div class="footer-top">
        <span class="footer-hello">hello world!</span>
        <div class="socials">
          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social">
            <img src="/img/devicons/linkedin.svg" alt="" width="24" height="24" class="mono" />
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social">
            <img src="/img/devicons/github.svg" alt="" width="24" height="24" />
          </a>
          <a href={`mailto:${EMAIL}`} aria-label="Email" class="social at">@</a>
        </div>
      </div>
    )}
    <div class="footer-bottom">
      <span>© 2026 {OWNER} · Lomé, Togo</span>
      <a href="#top" class="hl-link to-top">haut de page ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--cs-line); }
  .footer-inner { padding-top: 24px; padding-bottom: 24px; display: flex; flex-direction: column; gap: 36px; }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; font-size: 14px; color: #3a3a3a; }
  .big { background: var(--cs-ink); color: #fff; border-top: 0; }
  .big .footer-inner { padding-top: clamp(48px, 7vw, 80px); padding-bottom: 28px; }
  .big .footer-bottom { padding-top: 20px; border-top: 1px solid #333; color: #cfcfcf; }
  .big .to-top { color: var(--cs-accent); }
  .big .to-top:hover { background: transparent; color: #fff; }
  .footer-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .footer-hello {
    display: inline-block;
    transform: rotate(-2deg);
    padding: 4px 18px 10px;
    background: var(--cs-accent);
    color: var(--cs-ink);
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: clamp(48px, 8vw, 104px);
    line-height: 1;
  }
  .socials { display: flex; gap: 10px; }
  .social { width: 48px; height: 48px; display: grid; place-items: center; background: var(--cs-accent); }
  .social:hover { background: #fff; }
  .social img { display: block; }
  .mono { filter: grayscale(1) brightness(0); }
  .at { color: var(--cs-ink); font-family: var(--cs-display); font-weight: 700; font-size: 20px; }
  .at:hover { color: var(--cs-ink); }
</style>
