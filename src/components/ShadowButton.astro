---
interface Props {
  href: string
  size?: 'sm' | 'md' | 'lg'
  external?: boolean
}

// the page's one filled button (.btn in styles/site.css)
const { href, size = 'md', external = false } = Astro.props
---

<a
  href={href}
  class:list={['btn', 'shadow-btn', { lg: size === 'lg' }]}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>
