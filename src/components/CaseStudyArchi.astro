---
import type { CaseStudy } from '../lib/case-studies'

interface Props {
  archi: CaseStudy['archi']
  snippet: CaseStudy['snippet']
}

const { archi, snippet } = Astro.props
---

<section id="archi" data-spy data-section="architecture" class="archi on-night">
  <div class="container inner">
    <div data-reveal class="head">
      <h2>Sous le capot</h2>
      <p class="lead">{archi.note}</p>
    </div>
    <ol data-reveal class="diagram" aria-label="Architecture, de l’utilisateur aux données">
      {archi.layers.map(col => (
        <li class="layer">
          <p class="layer-name">{col.layer}</p>
          {col.nodes.map(nd => (
            <div class:list={['node', { hi: nd.hi }]}>
              <span class="node-t">{nd.t}</span>
              <span class="node-s">{nd.s}</span>
            </div>
          ))}
        </li>
      ))}
    </ol>
    <figure data-reveal class="snippet">
      <figcaption class="snippet-file">{snippet.file}</figcaption>
      <pre><code>{snippet.code}</code></pre>
      <p class="snippet-note">// exemple illustratif</p>
    </figure>
  </div>
</section>

<style>
  .inner { padding-block: var(--section-gap); display: flex; flex-direction: column; gap: var(--space-2xl); }
  .head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-md) var(--gap-columns); align-items: end; }
  .head .lead { color: var(--color-on-night-2); }
  .diagram { margin: 0; padding: 0; list-style: none; counter-reset: layer; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); border-top: 2px solid var(--color-on-night); }
  .layer { display: flex; flex-direction: column; gap: var(--space-sm); padding: var(--space-lg) var(--space-lg) 0; border-left: var(--rule-hair) solid var(--color-night-rule); }
  .layer:first-child { padding-left: 0; border-left: 0; }
  .layer-name { font-size: var(--text-sm); color: var(--color-on-night-muted); }
  .node { display: flex; flex-direction: column; gap: var(--space-3xs); padding: var(--space-sm) var(--space-md); border: var(--rule-hair) solid var(--color-on-night-muted); }
  .node.hi { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-ink); }
  .node-t { font: var(--display-weight) var(--text-lg)/1.2 var(--font-display); }
  .node-s { font-size: var(--text-sm); opacity: 0.85; }
  .snippet { margin: 0; background: var(--color-night-2); }
  .snippet-file { padding: var(--space-sm) var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-night-rule); font: var(--text-sm)/1.4 var(--font-outlier); color: var(--color-on-night-muted); overflow-wrap: anywhere; }
  pre { margin: 0; padding: var(--space-lg); overflow-x: auto; font: var(--text-sm)/1.75 var(--font-outlier); }
  pre code { font: inherit; }
  .snippet-note { padding: var(--space-sm) var(--space-lg); border-top: var(--rule-hair) solid var(--color-night-rule); font: var(--text-sm)/1.4 var(--font-outlier); color: var(--color-on-night-muted); }
  @media (max-width: 60rem) {
    .head { grid-template-columns: minmax(0, 1fr); }
    .layer, .layer:first-child { padding: var(--space-md) 0 0; border-left: 0; }
  }
</style>
