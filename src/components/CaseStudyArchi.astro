---
import type { CaseStudy } from '../lib/case-studies'

interface Props {
  archi: CaseStudy['archi']
  snippet: CaseStudy['snippet']
  kicker: string
}

const { archi, snippet, kicker } = Astro.props
---

<section id="archi" data-spy data-section="architecture" class="archi">
  <div class="wrap inner">
    <div data-reveal class="head">
      <span class="kicker-label">{kicker}</span>
      <h2>Sous le capot</h2>
      <p>{archi.note}</p>
    </div>
    <ol data-reveal class="diagram" aria-label="Architecture, de l’utilisateur aux données">
      {archi.layers.map((col, i) => (
        <li class="layer">
          <div class="nodes">
            <span class="layer-name">{col.layer}</span>
            {col.nodes.map(nd => (
              <div class:list={['node', { hi: nd.hi }]}>
                <span class="node-t">{nd.t}</span>
                <span class="node-s">{nd.s}</span>
              </div>
            ))}
          </div>
          {i < archi.layers.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>
    <div data-reveal class="snippet">
      <div class="window">
        <div class="bar">
          <div class="dots" aria-hidden="true"><span></span><span></span><span class="on"></span></div>
          <span class="snippet-file">{snippet.file}</span>
        </div>
        <pre><code>{snippet.code}</code></pre>
        <div class="snippet-note">// exemple illustratif</div>
      </div>
    </div>
  </div>
</section>

<style>
  .archi { background: var(--cs-ink); color: #fff; }
  .inner { padding-top: clamp(56px, 8vw, 96px); padding-bottom: clamp(56px, 8vw, 96px); display: flex; flex-direction: column; gap: 36px; }
  .head { display: flex; flex-direction: column; gap: 12px; }
  .head .kicker-label { color: var(--cs-accent); }
  h2 { margin: 0; font-family: var(--cs-display); font-weight: 700; font-size: clamp(32px, 4vw, 48px); line-height: 1.05; }
  .head p { margin: 0; max-width: 60ch; font-size: 17px; line-height: 1.6; color: #cfcfcf; }
  .diagram { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .layer { display: flex; align-items: center; gap: 14px; flex: 1 1 180px; min-width: 0; }
  .nodes { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .layer-name { font-family: var(--cs-mono); font-size: 11px; color: #bdbdbd; text-transform: uppercase; letter-spacing: 0.08em; }
  .node {
    padding: 12px 14px;
    background: #fff;
    color: var(--cs-ink);
    border: 2px solid var(--cs-ink);
    box-shadow: 4px 4px 0 var(--cs-accent);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .node.hi { background: var(--cs-accent); }
  .node-t { font-family: var(--cs-display); font-weight: 700; font-size: 16px; }
  .node-s { font-family: var(--cs-mono); font-size: 12px; color: #3a3a3a; }
  .arrow { flex: 0 0 auto; font-family: var(--cs-display); font-weight: 700; font-size: 26px; color: var(--cs-accent); }
  .snippet { position: relative; margin: 8px 12px 12px 0; }
  .snippet::before { content: ''; position: absolute; inset: 0; transform: translate(12px, 12px); background: var(--cs-accent); }
  .window { position: relative; background: #1b1b1b; border: 3px solid #fff; color: #ededed; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 16px; border-bottom: 1px solid #333; }
  .dots { display: flex; gap: 7px; }
  .dots span { width: 11px; height: 11px; border-radius: 50%; background: #3a3a3a; }
  .dots .on { background: var(--cs-accent); }
  .snippet-file { font-family: var(--cs-mono); font-size: 12px; color: #bdbdbd; overflow-wrap: anywhere; }
  pre {
    margin: 0;
    padding: 20px 22px 22px;
    overflow-x: auto;
    font-family: var(--cs-mono);
    font-size: clamp(12px, 1.1vw, 14px);
    line-height: 1.75;
  }
  pre code { font-family: inherit; }
  .snippet-note { padding: 10px 22px; border-top: 1px solid #333; font-family: var(--cs-mono); font-size: 12px; color: #bdbdbd; }
</style>
