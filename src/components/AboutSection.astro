---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { Profile } from '../lib/profile'
import { findImage, resolveImage } from '../lib/images'
import { OWNER } from '../lib/site'

interface Props {
  about: Profile['about']
  interests: Profile['interests']
  label: string
}

const { about, interests, label } = Astro.props
// shown once the file is added to src/assets/img/
const portrait: ImageMetadata | undefined = findImage(['/img/justin-portrait.png', '/img/justin-portrait.jpg'])
---

<section id="apropos" data-section={label} class="about on-night">
  <div class="container inner">
    <div data-reveal class="side">
      <h2 class="section-title">appelle-moi Justin</h2>
      {portrait && (
        <figure class="portrait">
          <Image src={portrait} alt={`Portrait de ${OWNER}`} widths={[340, 680]} sizes="340px" />
        </figure>
      )}
      <dl class="details">
        {about.details.map(d => (
          <div><dt>{d.k}</dt><dd>{d.v.replace(/ · /g, ", ")}</dd></div>
        ))}
      </dl>
    </div>

    <div class="body">
      <div data-reveal class="bio">
        {about.bio.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
        {about.now && <p class="now">En ce moment, {about.now}.</p>}
      </div>
      <div class="principles">
        <h3 class="principles-title">Comment je travaille</h3>
        <ol class="principle-list">
          {about.principles.map(pr => (
            <li data-reveal class="principle">
              <span class="principle-t">{pr.title}</span>
              <span class="principle-text">{pr.text}</span>
            </li>
          ))}
        </ol>
      </div>
      <div class="favs">
        <div class="fav-buttons" role="group" aria-label="Centres d’intérêt">
          {interests.map((i, n) => (
            <button type="button" data-fav={i.k} aria-pressed={n === 0}>fav. {i.k}</button>
          ))}
        </div>
        {interests.map((i, n) => (
          <div class="fav-panel" data-fav-panel={i.k} hidden={n !== 0}>
            {i.photo && (
              <div class="fav-photo">
                <Image src={resolveImage(i.photo)} alt="" widths={[480, 960]} sizes="(min-width: 1200px) 480px, 100vw" />
              </div>
            )}
            <p class="fav-card">
              <span class="fav-k">fav. {i.k}</span>
              <span class="fav-v">{i.v}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .inner { padding-block: var(--section-gap); display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-2xl) var(--gap-columns); align-items: start; }
  .side { position: sticky; top: var(--space-3xl); display: flex; flex-direction: column; gap: var(--space-xl); }
  .portrait { margin: 0; max-width: 340px; }
  .portrait :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; }
  .details { margin: 0; display: flex; flex-direction: column; border-top: var(--rule-hair) solid var(--color-night-rule); }
  .details div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-md); padding-block: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-night-rule); }
  .details dt { font-size: var(--text-sm); color: var(--color-on-night-muted); }
  .details dd { margin: 0; }

  .body { min-width: 0; display: flex; flex-direction: column; gap: var(--space-3xl); }
  .bio { display: flex; flex-direction: column; gap: var(--space-lg); }
  .bio p { max-width: 62ch; color: var(--color-on-night-2); }
  .bio p.lead { max-width: 30ch; font: var(--display-weight) var(--text-2xl)/1.25 var(--font-display); letter-spacing: -0.01em; color: var(--color-on-night); }
  .now { color: var(--color-on-night); }
  .now b { font-weight: 700; }
  .principles { display: flex; flex-direction: column; gap: var(--space-lg); }
  .principle-list { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .principle { display: flex; flex-direction: column; gap: var(--space-xs); padding: 0 var(--space-lg); border-left: var(--rule-hair) solid var(--color-night-rule); }
  .principle:first-child { padding-left: 0; border-left: 0; }
  .principle-t { font: var(--display-weight) var(--text-lg)/1.25 var(--font-display); }
  .principle-text { color: var(--color-on-night-2); }

  .favs { display: flex; flex-direction: column; gap: var(--space-md); }
  .fav-buttons { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .fav-buttons button {
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 2px solid var(--color-on-night);
    background: transparent;
    color: var(--color-on-night);
    font-size: var(--text-md);
    cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
  }
  .fav-buttons button:hover { background: var(--color-night-2); }
  .fav-buttons button:active { background: var(--color-night-rule); }
  .fav-buttons button[aria-pressed='true'] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-ink); }
  .fav-buttons button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .fav-panel { display: flex; flex-wrap: wrap; }
  .fav-photo { flex: 1.5 1 320px; min-width: 0; position: relative; min-height: 300px; filter: grayscale(1); }
  .fav-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fav-card {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-xl);
    background: var(--color-field);
    color: var(--color-field-ink);
  }
  .fav-k { font: var(--display-weight) var(--text-section)/1 var(--font-display); letter-spacing: var(--tracking-display); }
  .fav-v { font-size: var(--text-lg); }
  @media (max-width: 60rem) {
    .inner { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; }
    .principle-list { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    .principle, .principle:first-child { padding: 0; border-left: 0; }
  }
</style>
