---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { Profile } from '../lib/profile'
import { findImage, resolveImage } from '../lib/images'
import { kicker, OWNER } from '../lib/site'

interface Props {
  about: Profile['about']
  interests: Profile['interests']
  label: string
}

const { about, interests, label } = Astro.props
// shown once the file is added to src/assets/img/
const portrait: ImageMetadata | undefined = findImage(['/img/justin-portrait.png', '/img/justin-portrait.jpg'])
---

<section id="apropos" data-section={label} class="about">
  <div class="wrap inner">
    <div data-reveal class="side">
      <div class="head">
        <span class="kicker-label">{kicker('apropos', 'à propos de moi')}</span>
        <h2 class="section-title">appelle-moi Justin</h2>
      </div>
      {portrait && (
        <figure class="portrait">
          <Image src={portrait} alt={`Portrait de ${OWNER}`} widths={[340, 680]} sizes="340px" />
          <figcaption>hello, c’est moi !</figcaption>
        </figure>
      )}
      <dl class="details">
        {about.details.map(d => (
          <>
            <dt>{d.k}</dt>
            <dd>{d.k === 'Dispo' && <span class="live" aria-hidden="true"></span>}{d.v}</dd>
          </>
        ))}
      </dl>
    </div>

    <div class="body">
      <div data-reveal class="bio">
        {about.bio.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
        {about.now && <div class="now"><span>en ce moment →</span> {about.now}</div>}
      </div>
      <div class="principles">
        <span class="kicker-label">› comment je travaille</span>
        <div class="principle-grid">
          {about.principles.map((pr, i) => (
            <div data-reveal class="principle">
              <span class="principle-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="principle-t">{pr.title}</span>
              <span>{pr.text}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="favs">
        <div class="fav-buttons" role="group" aria-label="Centres d’intérêt">
          {interests.map((i, n) => (
            <button type="button" data-fav={i.k} aria-pressed={n === 0}>fav. {i.k}</button>
          ))}
        </div>
        {interests.map((i, n) => (
          <div class="fav-panel" data-fav-panel={i.k} hidden={n !== 0}>
            {i.photo && (
              <div class="fav-photo">
                <Image src={resolveImage(i.photo)} alt="" widths={[480, 960]} sizes="(min-width: 1200px) 480px, 100vw" />
              </div>
            )}
            <div class="fav-card">
              <span class="bar"></span>
              <div class="fav-text">
                <span class="fav-k">fav.<br />{i.k}</span>
                <span class="fav-v">{i.v}</span>
              </div>
              <span class="bar"></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about { background: var(--cs-ink); color: #fff; overflow-x: clip; }
  .inner {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(56px, 8vw, 104px);
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
  }
  .side { flex: 1 1 280px; display: flex; flex-direction: column; gap: 22px; }
  .head { display: flex; flex-direction: column; gap: 12px; }
  .kicker-label { color: var(--cs-accent); }
  .portrait { margin: 8px 14px 14px 0; position: relative; max-width: 340px; transform: rotate(-2.5deg); }
  .portrait::before { content: ''; position: absolute; inset: 0; transform: translate(12px, 12px); background: var(--cs-accent); }
  .portrait :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border: 3px solid #fff;
  }
  .portrait figcaption {
    position: absolute;
    left: -10px;
    bottom: 18px;
    padding: 5px 12px;
    background: var(--cs-accent);
    color: var(--cs-ink);
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: 14px;
    transform: rotate(3deg);
    border: 2px solid var(--cs-ink);
  }
  .details { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 10px 18px; padding-top: 14px; border-top: 1px dotted #5a5a5a; }
  .details dt { font-family: var(--cs-mono); font-size: 12px; color: #bdbdbd; text-transform: uppercase; letter-spacing: 0.06em; padding-top: 3px; }
  .details dd { margin: 0; display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 15px; }
  .live { width: 9px; height: 9px; border-radius: 50%; background: #3ddc6f; box-shadow: 0 0 0 4px rgba(61, 220, 111, 0.2); }

  .body { flex: 2 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 36px; }
  .bio { display: flex; flex-direction: column; gap: 16px; max-width: 62ch; }
  .bio p { margin: 0; font-size: 17px; line-height: 1.7; color: #d6d6d6; text-wrap: pretty; }
  .bio p.lead { font-size: clamp(19px, 1.8vw, 22px); line-height: 1.65; color: #fff; }
  .now {
    align-self: flex-start;
    padding: 8px 14px;
    border: 2px dashed var(--cs-accent);
    font-family: var(--cs-mono);
    font-size: 13px;
    color: var(--cs-accent);
  }
  .now span { color: #fff; }
  .principles { display: flex; flex-direction: column; gap: 14px; }
  .principle-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 16px; }
  .principle {
    padding: 18px 18px 20px;
    background: #fff;
    color: var(--cs-ink);
    border: 2px solid var(--cs-ink);
    box-shadow: 5px 5px 0 var(--cs-accent);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.55;
  }
  .principle-n { font-family: var(--cs-mono); font-size: 12px; font-weight: 700; }
  .principle-t { font-family: var(--cs-display); font-weight: 700; font-size: 19px; line-height: 1.2; }

  .favs { display: flex; flex-direction: column; gap: 16px; }
  .fav-buttons { display: flex; flex-wrap: wrap; gap: 8px; }
  .fav-buttons button {
    all: unset;
    cursor: pointer;
    padding: 7px 14px;
    border: 2px solid var(--cs-accent);
    color: var(--cs-accent);
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: 15px;
  }
  .fav-buttons button:hover, .fav-buttons button[aria-pressed='true'] { background: var(--cs-accent); color: var(--cs-ink); }
  .fav-buttons button:focus-visible { outline: 3px solid var(--cs-accent); outline-offset: 3px; }
  .fav-panel { display: flex; flex-wrap: wrap; min-height: 300px; }
  .fav-photo { flex: 1.5 1 320px; min-width: 0; position: relative; min-height: 300px; background: #2a2a2a; filter: grayscale(1); }
  .fav-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fav-card {
    flex: 1 1 260px;
    min-width: 0;
    background-color: var(--cs-accent);
    background-image: radial-gradient(rgba(17, 17, 17, 0.06) 1.4px, transparent 1.6px);
    background-size: 12px 12px;
    color: var(--cs-ink);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px 0;
  }
  .bar { display: block; width: 72%; height: 8px; border-radius: 4px; background: var(--cs-ink); }
  .fav-text { padding: 28px 28px 30px; display: flex; flex-direction: column; gap: 12px; }
  .fav-k { font-family: var(--cs-display); font-weight: 700; font-size: clamp(40px, 4.4vw, 60px); line-height: 0.95; }
  .fav-v { font-family: var(--cs-display); font-weight: 600; font-size: 17px; letter-spacing: 0.14em; text-transform: uppercase; }
</style>
