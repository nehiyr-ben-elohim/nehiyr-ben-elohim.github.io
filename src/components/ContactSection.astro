---
import { BOOKING_URL, EMAIL, LINKEDIN_URL } from '../lib/site'
import { MIN_MESSAGE } from '../lib/contact-validation'

const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? ''
// no endpoint in production: the form would POST to the page itself, so point to email instead
const showForm = !!endpoint || !import.meta.env.PROD
const REQUEST_TYPES = ['mission freelance', 'CDI', 'collaboration', 'autre']
const DELAYS = ['Dès que possible', 'Sous 1 mois', 'Dans 1 à 3 mois', 'Pas encore défini']
const BUDGETS = ['Moins de 3 000 €', '3 000 – 10 000 €', 'Plus de 10 000 €', 'TJM à discuter']
const linkedinHandle = new URL(LINKEDIN_URL).pathname.split('/').filter(Boolean).pop()
---

<section id="contact" data-section="me contacter" class="contact">
  <div class="container inner">
    <div class="side">
      <div data-reveal class="head-title">
        <h2 class="section-title">On se donne rendez-vous&nbsp;?</h2>
        <p class="pitch">Nous pouvons parler de ton projet «&nbsp;amazing&nbsp;» autour d’un café.</p>
      </div>
      <ul class="facts">
        <li>Réponse sous 48&nbsp;h</li>
        <li>Lomé, GMT+0</li>
        <li>Disponible dès maintenant</li>
      </ul>
    </div>

    <div class="act">
      <div class="cards">
        <div data-reveal class="card">
          <p class="card-k">Écrire un email</p>
          <a href={`mailto:${EMAIL}`} class="card-v email">{EMAIL}</a>
          <button type="button" class="copy" data-copy-email={EMAIL} data-js-only>copier l’email</button>
        </div>
        {BOOKING_URL && (
          <a data-reveal href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="card booking">
            <span class="card-k">Réserver un appel</span>
            <span class="card-v">30 min en visio</span>
          </a>
        )}
        <div data-reveal class="card">
          <p class="card-k">Sur LinkedIn</p>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="card-v"><img src="/img/devicons/linkedin.svg" alt="" width="24" height="24" />{linkedinHandle}</a>
        </div>
      </div>

      {showForm ? (
        <form data-reveal action={endpoint} method="POST" class="contact-form" data-contact-form novalidate>
          <div class="fields">
            <fieldset class="types">
              <legend>C’est pour…</legend>
              <input type="hidden" name="type" value={REQUEST_TYPES[0]} data-request-type />
              <div role="radiogroup" aria-label="C’est pour…" class="type-list">
                {REQUEST_TYPES.map((t, i) => (
                  <button type="button" role="radio" aria-checked={i === 0} data-request={t}>{t}</button>
                ))}
              </div>
            </fieldset>
            <div class="grid">
              <label>
                <span>Comment je peux t’appeler ?</span>
                <input name="name" autocomplete="given-name" placeholder="Ton prénom" aria-describedby="err-name" />
                <span id="err-name" class="error" data-error="name" role="alert" hidden>Indique ton prénom.</span>
              </label>
              <label>
                <span>Ton adresse email</span>
                <input type="email" name="email" autocomplete="email" inputmode="email" placeholder="prenom@entreprise.com" aria-describedby="err-email" />
                <span id="err-email" class="error" data-error="email" role="alert" hidden>Cette adresse email n’est pas valide.</span>
              </label>
              <label>
                <span>Délai <span class="optional">(facultatif)</span></span>
                <select name="delai">
                  <option value="">Choisir</option>
                  {DELAYS.map(d => <option>{d}</option>)}
                </select>
              </label>
              <label>
                <span>Budget <span class="optional">(facultatif)</span></span>
                <select name="budget">
                  <option value="">Choisir</option>
                  {BUDGETS.map(b => <option>{b}</option>)}
                </select>
              </label>
            </div>
            <label>
              <span>Alors, dis-moi</span>
              <textarea name="message" rows="5" placeholder="Ton projet, ton contexte, ce que tu attends…" aria-describedby="err-message"></textarea>
              <span id="err-message" class="error" data-error="message" role="alert" hidden>Écris quelques mots sur ton projet ({MIN_MESSAGE} caractères minimum).</span>
            </label>
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
            <p class="message-error" role="alert" hidden>Le message n’est pas parti. Réessaie dans un instant, ou écris-moi directement.</p>
            <div class="submit-row">
              <p class="privacy">Tes informations servent uniquement à te répondre.</p>
              <button type="submit" class="btn lg submit"><span data-submit-label>hello</span></button>
            </div>
          </div>
          <div class="message-sent" role="status" hidden>
            <p class="sent-title">Message envoyé, merci <span data-sent-name></span> !</p>
            <p>Je te réponds sous 48&nbsp;h.</p>
            <button type="button" class="reset text-link" data-contact-reset>envoyer un autre message</button>
          </div>
        </form>
      ) : (
        <p class="no-form">Le formulaire arrive bientôt. En attendant, l’email ci-dessus est le plus rapide.</p>
      )}
    </div>
  </div>
</section>

<style>
  .inner { padding-block: var(--section-gap); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-2xl) var(--gap-columns); align-items: start; }
  .side { display: flex; flex-direction: column; gap: var(--space-xl); }
  .head-title { display: flex; flex-direction: column; gap: var(--space-md); }
  .pitch { font-size: var(--text-lead); font-style: italic; color: var(--color-ink-2); }
  .facts { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; border-top: var(--rule-hair) solid var(--color-ink); }
  .facts li { padding-block: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .act { min-width: 0; display: flex; flex-direction: column; gap: var(--space-xl); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--space-lg) var(--gap-columns); padding-bottom: var(--space-xl); border-bottom: var(--rule-hair) solid var(--color-ink); }
  .card { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xs); text-decoration: none; }
  .card-k { font-size: var(--text-sm); color: var(--color-muted); }
  .card-v { display: inline-flex; align-items: center; gap: var(--space-xs); font: var(--display-weight) var(--text-2xl)/1.15 var(--font-display); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; overflow-wrap: anywhere; }
  .card-v:hover { background: var(--color-accent); }
  .copy {
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 2px solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .copy:hover, .copy[data-copied] { background: var(--color-accent); }
  .copy:active { background: var(--color-paper-3); }

  .contact-form { min-width: 0; }
  .fields { display: flex; flex-direction: column; gap: var(--space-lg); padding: var(--space-xl); border: 2px solid var(--color-ink); background: var(--color-paper-2); }
  .contact-form[data-sent] .fields { display: none; }
  .types { margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; }
  .types legend, label > span:first-child { padding: 0; margin-bottom: var(--space-xs); font-weight: 700; }
  .type-list { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .type-list button {
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 2px solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: var(--text-md);
    cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .type-list button:hover { background: var(--color-paper-3); }
  .type-list button:active { background: var(--color-rule); }
  .type-list button[aria-checked='true'] { background: var(--color-ink); color: var(--color-paper); }
  .type-list button:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg); }
  label { display: flex; flex-direction: column; }
  .optional { font-weight: 400; color: var(--color-muted); }
  input, textarea, select {
    border: 2px solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: var(--text-md);
    outline: 2px solid transparent;
    outline-offset: -4px;
  }
  input:focus-visible, textarea:focus-visible, select:focus-visible { outline-color: var(--color-focus); }
  input, select { min-height: 52px; padding: 0 var(--space-md); }
  textarea { padding: var(--space-sm) var(--space-md); line-height: 1.5; resize: vertical; }
  ::placeholder { color: var(--color-muted); }
  [aria-invalid='true'] { border-color: var(--color-error); }
  .error { min-height: 1lh; margin-top: var(--space-2xs); font-size: var(--text-sm); font-weight: 700; color: var(--color-error); }
  .honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .message-error { padding: var(--space-sm) var(--space-md); border: 2px solid var(--color-error); color: var(--color-error); font-weight: 700; }
  .submit-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-md); }
  .privacy { font-size: var(--text-sm); color: var(--color-muted); }
  .submit { border-color: var(--color-ink); }
  .submit:disabled { cursor: progress; }
  .message-sent { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-sm); padding: var(--space-xl); background: var(--color-accent); border: 2px solid var(--color-ink); }
  .sent-title { font: var(--display-weight) var(--text-2xl)/1.1 var(--font-display); }
  .reset { padding: 0; border: 0; background: none; color: var(--color-ink); cursor: pointer; }
  .no-form { font-size: var(--text-lg); color: var(--color-ink-2); }
  @media (max-width: 60rem) {
    .inner, .grid, .cards { grid-template-columns: minmax(0, 1fr); }
    .card-v { font-size: var(--text-lg); }
    .fields { padding: var(--space-lg); }
  }
</style>
