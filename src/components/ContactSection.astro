---
import { EMAIL, GITHUB_URL, LINKEDIN_URL } from '../lib/site'

const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? ''
// a missing endpoint would silently POST to the page itself
if (!endpoint && import.meta.env.PROD) {
  throw new Error('PUBLIC_FORMSPREE_ENDPOINT is not set: the contact form cannot send messages.')
}
---

<section id="contact" data-section="me contacter" class="wrap contact">
  <div class="intro">
    <span class="kicker-label">› un rendez-vous ?</span>
    <h2 class="section-title">On se donne rendez-vous&nbsp;?</h2>
    <p class="pitch">Nous pouvons parler de ton projet « amazing » autour d’un café.</p>
    <a href={`mailto:${EMAIL}`} class="email">{EMAIL}</a>
    <div class="socials">
      <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social">
        <img src="/img/devicons/linkedin.svg" alt="" width="24" height="24" class="mono" />
      </a>
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social">
        <img src="/img/devicons/github.svg" alt="" width="24" height="24" />
      </a>
    </div>
  </div>

  <form data-reveal action={endpoint} method="POST" class="contact-form" data-contact-form>
    <div class="fields">
      <label>
        <span>Comment je peux t’appeler ?</span>
        <input required name="name" autocomplete="given-name" placeholder="Ton prénom" />
      </label>
      <label>
        <span>Ton adresse email</span>
        <input required type="email" name="email" autocomplete="email" placeholder="prenom@entreprise.com" />
      </label>
      <label>
        <span>Alors, dis-moi</span>
        <textarea required name="message" rows="6" placeholder="Ton projet, tes délais, ton budget…"></textarea>
      </label>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
      <p class="message-error" role="alert" hidden>Oups, le message s’est perdu en route. Réessaie dans un instant.</p>
      <button type="submit" class="submit">
        <span class="face">hello</span>
      </button>
    </div>
    <div class="message-sent" role="status" hidden>
      <span class="sent-title">Message envoyé, merci !</span>
      <span>Je te réponds sous 48 h.</span>
    </div>
  </form>
</section>

<style>
  .contact {
    padding-top: clamp(56px, 8vw, 112px);
    padding-bottom: clamp(56px, 8vw, 112px);
    display: flex;
    flex-wrap: wrap;
    gap: 48px 72px;
  }
  .intro { flex: 1 1 320px; display: flex; flex-direction: column; gap: 16px; }
  .intro .section-title { line-height: 1.08; text-wrap: balance; }
  .pitch { margin: 0; font-style: italic; font-size: 18px; line-height: 1.6; color: var(--cs-body); }
  .email {
    align-self: flex-start;
    margin-top: 8px;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 26px);
    background: linear-gradient(transparent 60%, var(--cs-accent) 60%);
    padding: 0 2px;
    overflow-wrap: anywhere;
  }
  .socials { display: flex; gap: 10px; padding-top: 6px; }
  .social { width: 48px; height: 48px; display: grid; place-items: center; background: var(--cs-accent); }
  .social:hover { background: var(--cs-ink); }
  .social:hover img { filter: invert(1); }
  .mono { filter: grayscale(1) brightness(0); }
  .social:hover .mono { filter: grayscale(1) brightness(0) invert(1); }

  .contact-form { flex: 1.3 1 420px; min-width: 0; display: flex; flex-direction: column; }
  .fields { display: flex; flex-direction: column; gap: 18px; }
  .contact-form[data-sent] .fields { display: none; }
  label { display: flex; flex-direction: column; gap: 8px; }
  label span { font-family: var(--cs-display); font-weight: 700; font-size: 15px; }
  input, textarea {
    border: 2px solid var(--cs-ink);
    background: #fff;
    font-size: 16px;
    color: var(--cs-ink);
    border-radius: 0;
  }
  input { height: 52px; padding: 0 16px; }
  textarea { padding: 14px 16px; line-height: 1.5; resize: vertical; }
  .honeypot { position: absolute; left: -9999px; }
  .message-error { margin: 0; padding: 12px 16px; border: 2px solid #b3261e; color: #b3261e; font-weight: 600; }
  .submit {
    all: unset;
    cursor: pointer;
    align-self: flex-end;
    position: relative;
    display: inline-block;
    margin: 6px 8px 8px 0;
    transition: transform 0.12s ease-out;
  }
  .submit::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(8px, 8px);
    background: var(--cs-accent);
  }
  .submit:hover { transform: translate(-1px, -1px); }
  .submit:focus-visible { outline: 3px solid var(--cs-ink); outline-offset: 3px; }
  .submit:disabled { cursor: progress; opacity: 0.7; }
  .submit .face {
    position: relative;
    display: block;
    padding: 13px 44px;
    background: var(--cs-accent);
    border: 3px solid var(--cs-ink);
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: 18px;
  }
  .message-sent {
    align-self: center;
    width: 100%;
    padding: 32px;
    background: var(--cs-accent);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .message-sent:not([hidden]) { display: flex; }
  .sent-title { font-family: var(--cs-display); font-weight: 700; font-size: 28px; }
</style>
