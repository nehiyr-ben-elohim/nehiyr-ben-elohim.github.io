---
import { getImage } from 'astro:assets'
import type { Activity } from '../lib/activities'
import { resolveImage } from '../lib/images'

interface Props {
  item: Activity
}
const { item } = Astro.props
const bg = await getImage({ src: resolveImage(item.mediaURL), width: 1200 })
---

<article
  class="blog-article-item"
  style={`width: calc(${item.layout.x}vw * 0.75)`}
  data-article-year={item.finishedAt.getUTCFullYear()}
  data-article-month={item.finishedAt.getUTCMonth()}
>
  <div class="blog-article--inner" style={`background-image: url(${bg.src})`}>
    <a href={item.href}>
      <h3 class="blog-article--title">{item.title.toLowerCase()}</h3>
    </a>
  </div>
</article>

<style lang="scss">
  @import '../styles/components/blog-article.scss';
</style>
