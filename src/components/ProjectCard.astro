---
import ProjectShot from './ProjectShot.astro'
import type { CaseStudy } from '../lib/case-studies'

interface Props {
  p: CaseStudy
  hidden?: boolean
}

const { p, hidden = false } = Astro.props
const href = `/projets/${p.slug}`
---

<article
  data-reveal
  data-project-card
  data-slug={p.slug}
  data-cat={p.cat}
  data-featured={p.featured ? '' : undefined}
  hidden={hidden}
  class="card"
>
  <div class="visual" style={`background:${p.color}`}>
    <ProjectShot src={p.shot} name={p.title} ratio="16 / 8" sizes="(min-width: 1200px) 380px, 100vw" />
    <span class="kind">{p.kind}</span>
  </div>
  <div class="body">
    <div class="head">
      <h3><a href={href}>{p.title}</a></h3>
      <span class="period">{p.period}</span>
    </div>
    <span class="role">{p.role}</span>
    <p class="summary">{p.summary}</p>
    <div class="metric">
      <span class="metric-v">{p.metric.v}</span>
      <span class="metric-k">{p.metric.k}</span>
    </div>
    <div class="tags">{p.tags.map(t => <span class="tag">{t}</span>)}</div>
    <div class="links">
      <a href={href} class="study-link">étude de cas ›</a>
      {p.code && <a href={p.code} target="_blank" rel="noopener noreferrer" class="code-link">code ↗</a>}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 2px solid var(--cs-ink);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--cs-accent); }
  .visual { position: relative; padding: 16px 16px 32px; }
  .kind {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 4px 12px;
    background: var(--cs-accent);
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: 13px;
  }
  .body { flex: 1; padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 8px; }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 14px; }
  h3 { margin: 0; font-family: var(--cs-display); font-weight: 700; font-size: 20px; }
  h3 a:hover { background: var(--cs-accent); }
  .period { font-family: var(--cs-mono); font-size: 12px; color: var(--cs-muted); }
  .role { font-family: var(--cs-mono); font-size: 12px; font-weight: 700; }
  .summary {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--cs-body);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .metric { display: flex; align-items: baseline; gap: 10px; padding: 10px 0; border-top: 1px dotted var(--cs-ink); }
  .metric-v { font-family: var(--cs-display); font-weight: 700; font-size: 19px; white-space: nowrap; }
  .metric-k { font-size: 14px; color: #3a3a3a; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags .tag { font-size: 13px; }
  .links { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-top: auto; padding-top: 8px; }
  .study-link, .code-link {
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .study-link { text-decoration-color: var(--cs-accent); text-decoration-thickness: 4px; }
  .code-link { text-decoration-thickness: 2px; }
  .study-link:hover, .code-link:hover { background: var(--cs-accent); }
</style>
