---
import type { CaseStudy } from '../lib/case-studies'

interface Props {
  p: CaseStudy
  hidden?: boolean
}

// one row of the project index
const { p, hidden = false } = Astro.props
const href = `/projets/${p.slug}`
const commas = (s: string) => s.replace(/ · /g, ', ')
// kind only when the role does not already say it
const role = p.role.toLowerCase().startsWith(p.kind.toLowerCase()) ? commas(p.role) : `${commas(p.kind)}, ${commas(p.role)}`
---

<li
  data-reveal
  data-project-card
  data-slug={p.slug}
  data-cat={p.cat}
  data-featured={p.featured ? '' : undefined}
  hidden={hidden}
  class="row"
>
  <p class="when"><span class="mark" style={`background:${p.color}`} aria-hidden="true"></span><time>{p.period}</time></p>
  <div class="name">
    <h3><a href={href}>{p.title}</a></h3>
    <p class="role">{role}</p>
  </div>
  <p class="summary">{p.summary}</p>
  <p class="metric"><b class="metric-v">{p.metric.v}</b><span class="metric-k">{p.metric.k}</span></p>
  <div class="links">
    <a href={href} class="text-link study-link">lire l’étude</a>
    {p.code && <a href={p.code} target="_blank" rel="noopener noreferrer" class="text-link">voir le code</a>}
  </div>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) minmax(0, 4fr) minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-md) var(--gap-columns);
    align-items: baseline;
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-ink);
  }
  .when { display: flex; align-items: center; gap: var(--space-xs); font-size: var(--text-sm); color: var(--color-muted); }
  .mark { flex-shrink: 0; width: var(--space-sm); height: var(--space-sm); }
  .name { min-width: 0; display: flex; flex-direction: column; gap: var(--space-2xs); }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.14em; }
  .role { font-size: var(--text-sm); color: var(--color-muted); }
  .summary { color: var(--color-ink-2); }
  .metric { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .metric-v { font: var(--display-weight) var(--text-xl)/1.1 var(--font-display); font-variant-numeric: tabular-nums; }
  .metric-k { font-size: var(--text-sm); color: var(--color-muted); }
  .links { display: flex; flex-direction: column; align-items: flex-start; }
  .study-link { white-space: nowrap; }
  @media (max-width: 60rem) {
    .row { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
    .summary, .metric, .links { grid-column: 2; }
  }
  @media (max-width: 40rem) {
    .row { grid-template-columns: minmax(0, 1fr); }
    .summary, .metric, .links { grid-column: auto; }
  }
</style>
