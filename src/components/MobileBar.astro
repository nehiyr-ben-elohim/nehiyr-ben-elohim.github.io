---
import type { Profile } from '../lib/profile'
import { BOOKING_URL } from '../lib/site'

interface Props {
  audiences: Profile['audiences']
  cv?: string
}

// shown by scripts/home.ts once the visitor is past the hero (mobile only)
const { audiences, cv } = Astro.props
const ctas: Record<string, { href: string; label: string; external: boolean }> = {
  client: BOOKING_URL ? { href: BOOKING_URL, label: 'réserver un appel', external: true } : { href: '#contact', label: 'me contacter', external: false },
  rec: cv ? { href: cv, label: 'mon CV', external: true } : { href: '#parcours', label: 'mon parcours', external: false },
}
---

<div class="mobile-bar" data-mobile-bar hidden>
  {audiences.map(a => {
    const cta = ctas[a.id]
    return (
      <div class:list={['bar-row', `for-${a.id}`]}>
        <span class="bar-text">{a.bar}</span>
        <a href={cta.href} {...(cta.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{cta.label}</a>
      </div>
    )
  })}
</div>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: var(--z-sticky);
    padding: var(--space-xs) var(--space-md) calc(var(--space-xs) + env(safe-area-inset-bottom));
    background: var(--color-accent);
    border-top: 2px solid var(--color-ink);
  }
  .bar-row { display: flex; align-items: center; gap: var(--space-sm); }
  .bar-text { flex: 1; min-width: 0; font: var(--display-weight) var(--text-md)/1.2 var(--font-display); }
  a {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-md);
    background: var(--color-ink);
    color: var(--color-paper);
    font: var(--display-weight) var(--text-md)/1 var(--font-display);
    text-decoration: none;
    white-space: nowrap;
  }
  a:hover { background: var(--color-ink-2); }
  a:active { background: var(--color-muted); }
  @media (min-width: 60.0625rem) {
    .mobile-bar { display: none !important; }
  }
</style>
