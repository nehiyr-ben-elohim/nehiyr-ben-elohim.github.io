---
import type { Activity } from '../lib/activities'
import CurrentStep from './CurrentStep.astro'
import ProjectItem from './ProjectItem.astro'

interface Props {
  items: Activity[]
  showAll?: boolean
  stepIndicator?: boolean
}
const { items, showAll = false, stepIndicator = true } = Astro.props
---

<section id="works" class="row projects-row">
  {stepIndicator && <CurrentStep text="projets" />}

  <div class="row-inner">
    <div class:list={['projects-list', { 'show-all': showAll }]}>
      {items.map(item => <ProjectItem item={item} />)}
    </div>

    {
      !showAll && (
        <div class="projects-more">
          <a href="/projects" class="btn">tout voir</a>
        </div>
      )
    }
  </div>
</section>

<style lang="scss">
  @import '../styles/components/projects.scss';
</style>
