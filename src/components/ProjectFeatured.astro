---
import ShadowButton from './ShadowButton.astro'
import type { CaseStudy } from '../lib/case-studies'

interface Props {
  p: CaseStudy
}

const { p } = Astro.props
const href = `/projets/${p.slug}`
---

<article data-reveal data-project-featured class="featured">
  <div class="figure" style={`--mark:${p.color}`}>
    <span class="figure-v">{p.metric.v}</span>
    <span class="figure-k">{p.metric.k}</span>
  </div>
  <div class="body">
    <h3><a href={href}>{p.title}</a></h3>
    <p class="meta"><span class="kind">{p.kind.replace(/ · /g, ', ')}</span><time>{p.period}</time></p>
    <p class="role">{p.role.replace(/ · /g, ', ')}</p>
    <p class="summary">{p.summary}</p>
    <ul class="tags">{p.tags.map(t => <li class="tag">{t}</li>)}</ul>
    <div class="links">
      <ShadowButton href={href}>lire l’étude de cas</ShadowButton>
      {p.code && <a href={p.code} target="_blank" rel="noopener noreferrer" class="text-link">voir le code</a>}
    </div>
  </div>
</article>

<style>
  .featured { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--gap-columns); align-items: stretch; }
  .figure {
    min-height: 360px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-sm);
    padding: var(--space-xl);
    background: var(--mark);
    color: var(--color-on-night);
  }
  .figure-v { font: var(--display-weight) clamp(4rem, 6vw + 1rem, 7rem)/1 var(--font-display); letter-spacing: var(--tracking-display); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .figure-k { max-width: 24ch; font-size: var(--text-lg); line-height: 1.35; }
  .body { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); padding-block: var(--space-md); }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); font-size: var(--text-sm); color: var(--color-muted); }
  .kind { padding: 0 var(--space-xs); background: var(--color-accent); color: var(--color-ink); }
  h3 { font-size: var(--text-section); line-height: 1.05; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 0.12em; }
  .role { font-weight: 700; }
  .summary { max-width: 52ch; color: var(--color-ink-2); }
  .tags { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-xl); margin-top: var(--space-xs); }
  @media (max-width: 60rem) {
    .featured { grid-template-columns: minmax(0, 1fr); }
    .figure { min-height: 240px; padding: var(--space-lg); }
  }
</style>
