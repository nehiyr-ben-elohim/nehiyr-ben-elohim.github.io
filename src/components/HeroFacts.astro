---
import type { Profile } from '../lib/profile'

interface Props {
  facts: Profile['facts']
}

const { facts } = Astro.props
---

<dl class="facts">
  {facts.map(f => (
    <a href={f.href} data-fact>
      <dt>{f.k}</dt>
      {f.n !== undefined ? (
        <dd class="num"><span data-count={f.n}>{f.n}</span>{f.suf}</dd>
      ) : (
        <dd>{f.v}</dd>
      )}
    </a>
  ))}
</dl>

<style>
  .facts { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  a {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-lg);
    border-left: var(--rule-hair) solid var(--color-ink);
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  a:first-child { padding-left: 0; border-left: 0; }
  a:hover dd { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.12em; }
  a:active { background: var(--color-paper-3); }
  dt { font-size: var(--text-sm); color: var(--color-muted); }
  dd { margin: 0; font: var(--display-weight) var(--text-3xl)/1 var(--font-display); white-space: nowrap; letter-spacing: var(--tracking-display); font-variant-numeric: tabular-nums; }
  @media (max-width: 40rem) {
    .facts { grid-template-columns: minmax(0, 1fr); }
    a, a:first-child { padding: var(--space-md) 0; border-left: 0; border-top: var(--rule-hair) solid var(--color-rule); }
    a:first-child { border-top: 0; }
  }
</style>
