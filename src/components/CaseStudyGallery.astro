---
import { getImage, Image } from 'astro:assets'
import type { CaseStudy } from '../lib/case-studies'
import { resolveImage } from '../lib/images'

interface Props {
  gallery: CaseStudy['gallery']
}

const { gallery } = Astro.props
const items = await Promise.all(
  gallery
    .filter((g): g is { cap: string; src: string } => !!g.src)
    .map(async g => ({ ...g, image: resolveImage(g.src), large: (await getImage({ src: resolveImage(g.src), width: 1600 })).src })),
)
---

<section id="galerie" data-spy data-section="galerie" class="gallery">
  <div class="container inner">
    <h2 data-reveal>En images</h2>
    <div class="grid">
      {items.map(g => (
        <figure data-reveal>
          <div class="pic">
            <Image src={g.image} alt={g.cap} widths={[480, 960]} sizes="(min-width: 1200px) 420px, 100vw" />
            <button type="button" class="zoom" data-zoom={g.large} data-zoom-cap={g.cap} aria-label={`Agrandir : ${g.cap}`}>agrandir</button>
          </div>
          <figcaption>{g.cap}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .inner { padding-block: var(--section-gap); display: flex; flex-direction: column; gap: var(--space-2xl); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--space-2xl) var(--gap-columns); }
  figure { margin: 0; display: flex; flex-direction: column; gap: var(--space-sm); }
  .pic { position: relative; outline: var(--rule-hair) solid var(--color-rule); outline-offset: -1px; }
  .pic :global(img) { width: 100%; height: auto; }
  .zoom { position: absolute; right: var(--space-sm); bottom: var(--space-sm); min-height: 44px; padding: 0 var(--space-md); border: 2px solid var(--color-ink); background: var(--color-paper); color: var(--color-ink); cursor: pointer; }
  .zoom:hover { background: var(--color-accent); }
  .zoom:active { background: var(--color-paper-3); }
  figcaption { font-size: var(--text-sm); color: var(--color-muted); }
</style>
