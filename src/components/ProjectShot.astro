---
import { Image } from 'astro:assets'
import { resolveImage } from '../lib/images'

interface Props {
  src?: string
  name: string
  ratio: string
  sizes: string
}

const { src, name, ratio, sizes } = Astro.props
---

<div class="project-shot" style={`aspect-ratio:${ratio}`}>
  {src ? (
    <Image src={resolveImage(src)} alt={`Capture d’écran — ${name}`} widths={[480, 960]} sizes={sizes} />
  ) : (
    <div class="placeholder" aria-hidden="true">{name}</div>
  )}
</div>

<style>
  .project-shot {
    position: relative;
    width: 100%;
    background: #fff;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.32);
    overflow: hidden;
  }
  .project-shot :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 12px;
    text-align: center;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 34px);
    color: #d6d6d6;
    background: repeating-linear-gradient(135deg, #fafafa 0 14px, #f3f3f3 14px 28px);
  }
</style>
