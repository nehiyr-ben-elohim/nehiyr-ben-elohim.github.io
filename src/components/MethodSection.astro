---
import type { Profile } from '../lib/profile'

interface Props {
  method: Profile['method']
  label: string
}

const { method, label } = Astro.props
---

<section id="methode" data-section={label} class="method">
  <div class="container inner">
    <div data-reveal class="head">
      <h2 class="section-title">Du premier appel à la prod</h2>
      <p class="lead">Un cadre simple, pour savoir à quoi t’attendre à chaque étape.</p>
    </div>
    <ol class="steps">
      {method.steps.map(s => (
        <li data-reveal class="step">
          <h3 class="step-t">{s.title}</h3>
          <p class="step-text">{s.text}</p>
          <p class="step-tag">{s.tag}</p>
        </li>
      ))}
    </ol>
    <div class="formats-block">
      <h3 class="formats-title">Trois formats possibles</h3>
      <div class="formats">
        {method.formats.map(f => (
          <div data-reveal class="format">
            <p class="format-t">{f.title}</p>
            <p class="format-text">{f.text}</p>
            <p class="format-fit">{f.fit}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .method { background: var(--color-paper-2); border-block: var(--rule-hair) solid var(--color-ink); }
  .inner { padding-block: var(--section-gap); display: flex; flex-direction: column; gap: var(--space-2xl); }
  .head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; gap: var(--space-md) var(--gap-columns); }
  .head .lead { color: var(--color-ink-2); }
  .steps { margin: 0; padding: 0; list-style: none; counter-reset: step; border-top: 2px solid var(--color-ink); }
  .step {
    counter-increment: step;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 4fr) minmax(0, 4fr) minmax(0, 3fr);
    gap: var(--space-sm) var(--gap-columns);
    align-items: baseline;
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-ink);
  }
  .step::before { content: counter(step); font: var(--display-weight) var(--text-2xl)/1 var(--font-display); font-variant-numeric: tabular-nums; }
  .step-text { color: var(--color-ink-2); }
  .step-tag { justify-self: start; padding: 0 var(--space-xs); background: var(--color-accent); font-size: var(--text-sm); }
  .formats-block { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-lg) var(--gap-columns); }
  .formats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .format { display: flex; flex-direction: column; gap: var(--space-xs); padding: 0 var(--space-lg); border-left: var(--rule-hair) solid var(--color-ink); }
  .format:first-child { padding-left: 0; border-left: 0; }
  .format-t { font: var(--display-weight) var(--text-title)/1.2 var(--font-display); }
  .format-text { color: var(--color-ink-2); }
  .format-fit { font-size: var(--text-sm); color: var(--color-muted); }
  @media (max-width: 60rem) {
    .head, .formats-block { grid-template-columns: minmax(0, 1fr); }
    .step { grid-template-columns: minmax(0, 1fr) minmax(0, 6fr); }
    .step-text, .step-tag { grid-column: 2; }
    .formats { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    .format, .format:first-child { padding: 0; border-left: 0; }
  }
</style>
