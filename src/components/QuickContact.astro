---
import ShadowButton from './ShadowButton.astro'
import { EMAIL } from '../lib/site'
---

<section aria-label="Contact rapide" class="quick">
  <div data-reveal class="container box">
    <div class="copy">
      <p class="title">Un projet en tête ?</p>
      <p>Je suis disponible pour de nouvelles missions backend et ML.</p>
    </div>
    <div class="actions">
      <a href={`mailto:${EMAIL}`} class="text-link email">{EMAIL}</a>
      <ShadowButton href="#contact">me contacter</ShadowButton>
    </div>
  </div>
</section>

<style>
  .quick { background: var(--color-field); color: var(--color-field-ink); border-block: var(--rule-bold) solid var(--color-ink); }
  .box { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-lg) var(--space-2xl); padding-block: var(--space-2xl); }
  .copy { display: flex; flex-direction: column; gap: var(--space-xs); }
  .title { font: var(--display-weight) var(--text-section)/1.05 var(--font-display); letter-spacing: var(--tracking-display); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-xl); }
  .email { overflow-wrap: anywhere; }
  .email:hover { background: var(--color-paper); }
  .quick :global(.btn) { background: var(--color-paper); }
</style>
