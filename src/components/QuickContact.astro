---
import ShadowButton from './ShadowButton.astro'
import { EMAIL } from '../lib/site'
---

<section aria-label="Contact rapide" class="wrap quick">
  <div data-reveal class="box">
    <div class="copy">
      <span class="title">Un projet en tête ?</span>
      <span>Je suis disponible pour de nouvelles missions backend et ML.</span>
    </div>
    <div class="actions">
      <a href={`mailto:${EMAIL}`} class="email">{EMAIL}</a>
      <ShadowButton href="#contact" size="md" shadow="var(--cs-ink)">me contacter</ShadowButton>
    </div>
  </div>
</section>

<style>
  .quick { padding-bottom: clamp(56px, 7vw, 88px); }
  .box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding: clamp(22px, 3vw, 34px) clamp(22px, 3vw, 40px);
    background-color: var(--cs-accent);
    background-image: radial-gradient(rgba(17, 17, 17, 0.07) 1.4px, transparent 1.6px);
    background-size: 12px 12px;
    border: 3px solid var(--cs-ink);
  }
  .copy { display: flex; flex-direction: column; gap: 6px; font-size: 16px; }
  .title { font-family: var(--cs-display); font-weight: 700; font-size: clamp(24px, 2.8vw, 34px); line-height: 1.1; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; }
  .email { font-family: var(--cs-display); font-weight: 700; font-size: 16px; border-bottom: 3px solid var(--cs-ink); overflow-wrap: anywhere; }
  .email:hover { background: #fff; }
  .actions :global(.shadow-btn .face) { background: #fff; padding: 11px 26px; font-size: 16px; }
</style>
