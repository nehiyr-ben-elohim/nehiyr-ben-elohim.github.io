---
import { existsSync } from 'node:fs'
import SiteLayout from '../layouts/SiteLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ShadowButton from '../components/ShadowButton.astro'
import ProjectFeatured from '../components/ProjectFeatured.astro'
import ProjectCard from '../components/ProjectCard.astro'
import ContactSection from '../components/ContactSection.astro'
import HeroFacts from '../components/HeroFacts.astro'
import Bands from '../components/Bands.astro'
import QuickContact from '../components/QuickContact.astro'
import ExperienceSection from '../components/ExperienceSection.astro'
import SkillsSection from '../components/SkillsSection.astro'
import MethodSection from '../components/MethodSection.astro'
import NotesSection from '../components/NotesSection.astro'
import AboutSection from '../components/AboutSection.astro'
import MobileBar from '../components/MobileBar.astro'
import Rail from '../components/Rail.astro'
import { getCaseStudies } from '../lib/case-studies'
import { findImage } from '../lib/images'
import { getProfile } from '../lib/profile'
import { applyFilter, filterCounts, FILTERS } from '../lib/project-filter'
import { CV_PATH } from '../lib/terminal'
import { BOOKING_URL, EMAIL, GITHUB_URL, HOME_SECTIONS, kicker, LINKEDIN_URL, OWNER } from '../lib/site'

const projects = getCaseStudies()
const { featured, grid } = applyFilter(projects, 'all')
const featuredProject = projects.find(p => p.slug === featured)
const counts = filterCounts(projects)
const { facts, audiences, trust, marquee, skills, experience, method, notes, about, interests } = getProfile()
const label = (id: string) => HOME_SECTIONS.find(s => s.id === id)?.label ?? ''
const cv = existsSync(`public${CV_PATH}`) ? CV_PATH : undefined
const portrait = findImage(['/img/justin-portrait.png', '/img/justin-portrait.jpg'])
const description = 'Justin Potchona, développeur backend et machine learning basé à Lomé. API, plateformes web et outils data pour des équipes en France et en Afrique de l’Ouest.'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: OWNER,
  jobTitle: 'Développeur backend & machine learning',
  address: { '@type': 'PostalAddress', addressLocality: 'Lomé', addressCountry: 'TG' },
  email: `mailto:${EMAIL}`,
  sameAs: [LINKEDIN_URL, GITHUB_URL],
}
---

<SiteLayout
  title={`${OWNER} · Développeur backend & machine learning`}
  description={description}
  ogTitle={`${OWNER} · Backend & ML`}
  ogDescription="Des backends fiables et des fonctionnalités ML qui passent en production."
  image={portrait}
  jsonLd={jsonLd}
  rail
>
  <div data-audience="client">
  <SiteHeader variant="home" />

  <Rail label={label('top')} />

  <main>
    <div class="hero-bg">
      <section id="top" data-section={label('top')} class="wrap hero">
        <div class="hero-main">
          <div class="hero-copy">
            <div class="hero-meta">
              <div role="radiogroup" aria-label="Je suis" class="audience" data-audience-toggle data-js-only>
                {audiences.map((a, i) => (
                  <button type="button" role="radio" aria-checked={i === 0} data-aud={a.id} data-request={a.request}>{a.label}</button>
                ))}
              </div>
              <span class="status"><span class="dot"></span>Disponible pour des missions</span>
            </div>
            <h1><span data-anim="hello" class="hello">Hello world!</span></h1>
            {audiences.map(a => <p class:list={['promise', `for-${a.id}`]}>{a.promise}</p>)}
            <p class="intro">
              <strong>{OWNER}</strong>, développeur backend &amp; machine learning basé à Lomé. Depuis 6 ans, je conçois des API,
              des plateformes web et des outils data pour des équipes en France et en Afrique de l’Ouest.
            </p>
            <div class="hero-actions for-client">
              {BOOKING_URL ? (
                <ShadowButton href={BOOKING_URL} size="lg" shadow="var(--cs-ink)" external>réserver un appel</ShadowButton>
              ) : (
                <ShadowButton href="#contact" size="lg" shadow="var(--cs-ink)">me contacter</ShadowButton>
              )}
              <a href="#projets" class="coffee">voir mes projets <span aria-hidden="true">›</span></a>
            </div>
            <div class="hero-actions for-rec">
              {cv && <ShadowButton href={cv} size="lg" shadow="var(--cs-ink)" external>télécharger mon CV ↓</ShadowButton>}
              <a href="#parcours" class="coffee">voir mon parcours <span aria-hidden="true">›</span></a>
            </div>
          </div>
          <div data-anim="code" class="code-card">
            <div class="code-window">
              <div class="code-bar">
                <div class="dots" aria-hidden="true"><span></span><span></span><span class="on"></span></div>
                <span class="file">justin.py</span>
              </div>
              <pre><code><span class="c"># bienvenue sur mon portfolio</span>
<span class="k">class</span> Justin(Developer):
    role     = <span class="s">"backend &amp; machine learning"</span>
    stack    = [<span class="s">"Python"</span>, <span class="s">"Symfony"</span>, <span class="s">"Go"</span>]
    based_in = <span class="s">"Lomé, Togo"</span>
    mission  = <span class="s">"TheCodingMachine"</span>

    <span class="k">def</span> hello(self):
        <span class="k">return</span> <span class="s">"hello world!"</span></code></pre>
              <div class="term-log" data-term-log aria-live="polite">
                <div><span class="term-cmd">› python justin.py</span><span class="term-out">hello world!  (tape help pour explorer le site)</span></div>
              </div>
              <label class="term-input" data-js-only>
                <span class="k" aria-hidden="true">›</span>
                <input data-term data-has-cv={cv ? '' : undefined} aria-label="Terminal : tape help" placeholder="tape help puis Entrée" autocomplete="off" spellcheck="false" />
                <span data-anim="cursor" class="cursor" aria-hidden="true"></span>
              </label>
            </div>
          </div>
        </div>
        <HeroFacts facts={facts} />
        <div data-reveal class="trust">
          <span class="trust-k">ils m’ont fait confiance</span>
          {trust.map(t => (
            <span class="chip">{t.logo && <img src={t.logo} alt="" width="20" height="20" />}{t.name}</span>
          ))}
        </div>
      </section>
    </div>

    <Bands marquee={marquee} />

    <section id="projets" data-section={label('projets')} class="wrap projects">
      <div class="projects-head">
        <div data-reveal class="section-head">
          <span class="kicker-label">{kicker('projets', 'mes réalisations')}</span>
          <h2 class="section-title">Projets sélectionnés</h2>
        </div>
        <div class="filters" role="group" aria-label="Filtrer les projets">
          {FILTERS.map(f => (
            <button type="button" data-filter={f.id} aria-pressed={f.id === 'all'}>
              {f.label}<span class="count">{counts[f.id]}</span>
            </button>
          ))}
        </div>
      </div>
      {featuredProject && <ProjectFeatured p={featuredProject} />}
      <div class="grid">
        {projects.map(p => <ProjectCard p={p} hidden={!grid.includes(p.slug)} />)}
      </div>
    </section>

    <QuickContact />

    <ExperienceSection experience={experience} label={label('parcours')} />

    <SkillsSection skills={skills} label={label('competences')} />

    <MethodSection method={method} label={label('methode')} />

    <NotesSection notes={notes} label={label('notes')} />

    <AboutSection about={about} interests={interests} label={label('apropos')} />

    <ContactSection />
  </main>

  <SiteFooter big />
  <MobileBar audiences={audiences} cv={cv} />
  </div>
</SiteLayout>

<style>

  .hero-bg {
    background-color: #fffbe3;
    background-image: radial-gradient(rgba(17, 17, 17, 0.08) 1.3px, transparent 1.5px);
    background-size: 14px 14px;
    border-bottom: 3px solid var(--cs-ink);
  }
  .hero-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; }
  .audience { display: flex; border: 2px solid var(--cs-ink); background: #fff; }
  .audience button {
    all: unset;
    cursor: pointer;
    padding: 7px 14px;
    background: #fff;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: 14px;
  }
  .audience button:hover, .audience button[aria-checked='true'] { background: var(--cs-accent); }
  .promise { margin: 0; max-width: 24ch; font-family: var(--cs-display); font-weight: 700; font-size: clamp(24px, 2.6vw, 34px); line-height: 1.2; text-wrap: balance; }
  .trust { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; padding-top: 24px; border-top: 1px dotted var(--cs-ink); }
  .trust-k { font-family: var(--cs-mono); font-size: 12px; color: #3a3a3a; text-transform: uppercase; letter-spacing: 0.06em; margin-right: 8px; }
  .chip { display: flex; align-items: center; gap: 10px; padding: 8px 14px; background: #fff; border: 2px solid var(--cs-ink); font-family: var(--cs-display); font-weight: 700; font-size: 17px; }
  .chip img { display: block; filter: grayscale(1); }
  .hero {
    padding-top: clamp(48px, 8vw, 104px);
    padding-bottom: clamp(56px, 8vw, 96px);
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 64px);
    /* entrance slides in from the right */
    overflow-x: clip;
  }
  .hero-main { display: flex; flex-wrap: wrap; align-items: center; gap: 56px 64px; }
  .hero-copy { flex: 1.25 1 460px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 26px; }
  .status {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--cs-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--cs-body);
  }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #1f9d4a; box-shadow: 0 0 0 4px rgba(31, 157, 74, 0.18); }
  h1 {
    margin: 0;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: clamp(56px, 8vw, 112px);
    line-height: 1;
    letter-spacing: -0.015em;
  }
  .hello { display: inline-block; transform: rotate(-2deg); padding: 4px 18px 10px; background: var(--cs-accent); }
  .intro { margin: 0; max-width: 52ch; font-size: clamp(17px, 1.6vw, 20px); line-height: 1.65; color: var(--cs-body); text-wrap: pretty; }
  .intro strong { font-weight: 700; color: var(--cs-ink); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 26px; padding-top: 4px; }
  .coffee {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 4px;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: 18px;
    border-bottom: 3px solid var(--cs-ink);
  }
  .coffee:hover { background: var(--cs-accent); }

  .code-card { flex: 1 1 360px; min-width: 0; position: relative; margin: 0 12px 12px 0; }
  .code-card::before { content: ''; position: absolute; inset: 0; transform: translate(12px, 12px); background: var(--cs-accent); }
  .code-window { position: relative; background: var(--cs-ink); border: 3px solid var(--cs-ink); color: #ededed; }
  .code-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid #2c2c2c;
  }
  .dots { display: flex; gap: 7px; }
  .dots span { width: 11px; height: 11px; border-radius: 50%; background: #3a3a3a; }
  .dots .on { background: var(--cs-accent); }
  .file { font-family: var(--cs-mono); font-size: 12px; color: #bdbdbd; }
  pre {
    margin: 0;
    padding: 22px 22px 24px;
    overflow-x: auto;
    font-family: var(--cs-mono);
    font-size: clamp(13px, 1.15vw, 15px);
    line-height: 1.75;
  }
  pre code { font-family: inherit; }
  .c { color: #8a8a8a; }
  .k { color: var(--cs-accent); }
  .s { color: #a8e6b4; }
  .term-log {
    max-height: 150px;
    overflow-y: auto;
    padding: 10px 22px 0;
    border-top: 1px solid #2c2c2c;
    font-family: var(--cs-mono);
    font-size: 13px;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .term-log > :global(div) { display: flex; flex-direction: column; }
  .term-log :global(.term-cmd) { color: #bdbdbd; }
  .term-log :global(.term-out) { color: #ededed; white-space: pre-wrap; }
  .term-input { display: flex; align-items: center; gap: 10px; padding: 10px 22px 14px; font-family: var(--cs-mono); font-size: 13px; color: #bdbdbd; cursor: text; }
  .term-input input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: #fff; font-family: var(--cs-mono); font-size: 13px; caret-color: var(--cs-accent); }
  .term-input:focus-within { outline: 2px solid var(--cs-accent); outline-offset: -2px; }
  .cursor { display: inline-block; width: 8px; height: 16px; background: var(--cs-accent); }


  .section-head { display: flex; flex-direction: column; gap: 12px; }

  .projects {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(56px, 8vw, 104px);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .projects-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 40px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters button {
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 2px solid var(--cs-ink);
    background: #fff;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: 15px;
  }
  .filters button:hover, .filters button[aria-pressed='true'] { background: var(--cs-accent); }
  .filters .count { font-family: var(--cs-mono); font-size: 12px; font-weight: 500; }
  .filters button:focus-visible, .audience button:focus-visible { outline: 3px solid var(--cs-ink); outline-offset: 3px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 28px 24px; }



</style>

<style is:global>
  [data-audience='client'] .for-rec,
  [data-audience='rec'] .for-client { display: none !important; }
</style>
