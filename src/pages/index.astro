---
import BaseLayout from '../layouts/BaseLayout.astro'
import Menu from '../components/Menu.astro'
import FloatingHeader from '../components/FloatingHeader.astro'
import Landing from '../components/Landing.astro'
import AboutMe from '../components/AboutMe.astro'
import Projects from '../components/Projects.astro'
import Skills from '../components/Skills.astro'
import Contact from '../components/Contact.astro'
import Foot from '../components/Foot.astro'
import { getProjects } from '../lib/collection'
import { featured } from '../lib/activities'

const projects = featured(await getProjects(), 6)
---

<BaseLayout title="Jean-jacques AKAKPO">
  <Menu />
  <FloatingHeader />
  <Landing />
  <AboutMe />
  <Projects items={projects} />
  <Skills />
  <Contact />
  <Foot />
</BaseLayout>
