---
import { existsSync } from 'node:fs'
import SiteLayout from '../layouts/SiteLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ShadowButton from '../components/ShadowButton.astro'
import ProjectFeatured from '../components/ProjectFeatured.astro'
import ProjectCard from '../components/ProjectCard.astro'
import ContactSection from '../components/ContactSection.astro'
import HeroFacts from '../components/HeroFacts.astro'
import QuickContact from '../components/QuickContact.astro'
import ExperienceSection from '../components/ExperienceSection.astro'
import SkillsSection from '../components/SkillsSection.astro'
import MethodSection from '../components/MethodSection.astro'
import NotesSection from '../components/NotesSection.astro'
import AboutSection from '../components/AboutSection.astro'
import MobileBar from '../components/MobileBar.astro'
import { getCaseStudies } from '../lib/case-studies'
import { findImage } from '../lib/images'
import { getProfile } from '../lib/profile'
import { applyFilter, filterCounts, FILTERS } from '../lib/project-filter'
import { CV_PATH } from '../lib/terminal'
import { BOOKING_URL, EMAIL, GITHUB_URL, HOME_SECTIONS, LINKEDIN_URL, OWNER } from '../lib/site'

const projects = getCaseStudies()
const { featured, grid } = applyFilter(projects, 'all')
const featuredProject = projects.find(p => p.slug === featured)
const counts = filterCounts(projects)
const { facts, audiences, trust, skills, experience, method, notes, about, interests } = getProfile()
const label = (id: string) => HOME_SECTIONS.find(s => s.id === id)?.label ?? ''
const cv = existsSync(`public${CV_PATH}`) ? CV_PATH : undefined
const portrait = findImage(['/img/justin-portrait.png', '/img/justin-portrait.jpg'])
const description = 'Justin Potchona, développeur backend et machine learning basé à Lomé. API, plateformes web et outils data pour des équipes en France et en Afrique de l’Ouest.'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: OWNER,
  jobTitle: 'Développeur backend & machine learning',
  address: { '@type': 'PostalAddress', addressLocality: 'Lomé', addressCountry: 'TG' },
  email: `mailto:${EMAIL}`,
  sameAs: [LINKEDIN_URL, GITHUB_URL],
}
---

<SiteLayout
  title={`${OWNER} · Développeur backend & machine learning`}
  description={description}
  ogTitle={`${OWNER} · Backend & ML`}
  ogDescription="Des backends fiables et des fonctionnalités ML qui passent en production."
  image={portrait}
  jsonLd={jsonLd}
>
  <div data-audience="client">
  <SiteHeader variant="home" />

  <main>
    <section id="top" data-section={label('top')} class="top">
      <div class="container hero">
        <div class="hero-copy">
          <div role="radiogroup" aria-label="Je suis" class="audience" data-audience-toggle data-js-only>
            {audiences.map((a, i) => (
              <button type="button" role="radio" aria-checked={i === 0} data-aud={a.id} data-request={a.request}>{a.label}</button>
            ))}
          </div>
          <h1><span data-anim="hello" class="hello-band">Hello world!</span></h1>
          {audiences.map(a => <p class:list={['promise', 'lead', `for-${a.id}`]}>{a.promise}</p>)}
          <div class="hero-actions for-client">
            {BOOKING_URL ? (
              <ShadowButton href={BOOKING_URL} size="lg" external>réserver un appel</ShadowButton>
            ) : (
              <ShadowButton href="#contact" size="lg">me contacter</ShadowButton>
            )}
            <a href="#projets" class="coffee text-link">voir mes projets</a>
          </div>
          <div class="hero-actions for-rec">
            {cv && <ShadowButton href={cv} size="lg" external>télécharger mon CV</ShadowButton>}
            <a href="#parcours" class="coffee text-link">voir mon parcours</a>
          </div>
        </div>
        <figure data-anim="code" class="repl">
          <figcaption class="repl-file">justin.py</figcaption>
          <pre><code><span class="c"># bienvenue sur mon portfolio</span>
<span class="k">class</span> Justin(Developer):
    role     = <span class="s">"backend &amp; machine learning"</span>
    stack    = [<span class="s">"Python"</span>, <span class="s">"Symfony"</span>, <span class="s">"Go"</span>]
    based_in = <span class="s">"Lomé, Togo"</span>
    mission  = <span class="s">"TheCodingMachine"</span>

    <span class="k">def</span> hello(self):
        <span class="k">return</span> <span class="s">"hello world!"</span></code></pre>
          <div class="term-log" data-term-log aria-live="polite">
            <div><span class="term-cmd">$ python justin.py</span><span class="term-out">hello world!  (tape help pour explorer le site)</span></div>
          </div>
          <label class="term-input" data-js-only>
            <span class="prompt" aria-hidden="true">$</span>
            <input data-term data-has-cv={cv ? '' : undefined} aria-label="Terminal : tape help" placeholder="tape help puis Entrée" autocomplete="off" spellcheck="false" />
          </label>
        </figure>
      </div>

      <div class="container proof">
        <HeroFacts facts={facts} />
        <p data-reveal class="trust">
          <span class="trust-k">Équipes et clients</span>
          <span class="chips">
            {trust.map(t => (
              <span class="chip">{t.logo && <img src={t.logo} alt="" width="20" height="20" />}{t.name}</span>
            ))}
          </span>
        </p>
      </div>
    </section>

    <section id="projets" data-section={label('projets')} class="projects">
      <div class="container projects-inner">
        <div class="projects-head">
          <div data-reveal class="section-head">
            <h2 class="section-title">Projets sélectionnés</h2>
            <p class="lead">Missions client et projets perso, de 2019 à aujourd’hui.</p>
          </div>
          <div class="filters" role="group" aria-label="Filtrer les projets">
            {FILTERS.map(f => (
              <button type="button" data-filter={f.id} aria-pressed={f.id === 'all'}>
                {f.label}<span class="count">{counts[f.id]}</span>
              </button>
            ))}
          </div>
        </div>
        {featuredProject && <ProjectFeatured p={featuredProject} />}
        <ol class="index">
          {projects.map(p => <ProjectCard p={p} hidden={!grid.includes(p.slug)} />)}
        </ol>
      </div>
    </section>

    <QuickContact />

    <ExperienceSection experience={experience} label={label('parcours')} />

    <SkillsSection skills={skills} label={label('competences')} />

    <MethodSection method={method} label={label('methode')} />

    <NotesSection notes={notes} label={label('notes')} />

    <AboutSection about={about} interests={interests} label={label('apropos')} />

    <ContactSection />
  </main>

  <SiteFooter big />
  <MobileBar audiences={audiences} cv={cv} />
  </div>
</SiteLayout>

<style>
  .top { border-bottom: var(--rule-hair) solid var(--color-ink); }
  .hero {
    min-height: calc(100dvh - 112px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: var(--space-3xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .hero-copy { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-lg); }
  .audience { display: inline-flex; border: 2px solid var(--color-ink); }
  .audience button {
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .audience button + button { border-left: 2px solid var(--color-ink); }
  .audience button:hover { background: var(--color-paper-3); }
  .audience button:active { background: var(--color-rule); }
  .audience button[aria-checked='true'] { background: var(--color-ink); color: var(--color-paper); }
  .audience button:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  h1 { font-size: clamp(3.5rem, 6vw + 1rem, 7rem); line-height: 1; max-width: none; text-wrap: balance; }
  .hello-band { padding: var(--space-2xs) var(--space-xl) var(--space-sm); }
  .promise { max-width: 26ch; font-size: var(--text-xl); line-height: 1.35; color: var(--color-ink); text-wrap: balance; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-xl); }

  .repl { min-width: 0; min-height: min(620px, 68dvh); margin: 0; display: flex; flex-direction: column; background: var(--color-night); color: var(--color-on-night); }
  .repl-file {
    padding: var(--space-sm) var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-night-rule);
    font: var(--text-sm)/1.4 var(--font-outlier);
    color: var(--color-on-night-muted);
  }
  pre { margin: 0; padding: var(--space-xl) var(--space-lg); overflow-x: auto; font: clamp(0.8125rem, 0.35vw + 0.7rem, 1.0625rem)/1.85 var(--font-outlier); }
  pre code { font: inherit; }
  .c { color: var(--color-code-comment); }
  .k { color: var(--color-accent); }
  .s { color: var(--color-code-string); }
  .term-log {
    flex: 1;
    max-height: 220px;
    overflow-y: auto;
    padding: var(--space-sm) var(--space-lg) 0;
    border-top: var(--rule-hair) solid var(--color-night-rule);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    font: var(--text-sm)/1.6 var(--font-outlier);
  }
  .term-log > :global(div) { display: flex; flex-direction: column; }
  .term-log :global(.term-cmd) { color: var(--color-on-night-muted); }
  .term-log :global(.term-out) { color: var(--color-on-night); white-space: pre-wrap; }
  .term-input { display: flex; align-items: center; gap: var(--space-sm); padding: var(--space-sm) var(--space-lg) var(--space-md); font: var(--text-sm)/1 var(--font-outlier); color: var(--color-accent); cursor: text; }
  .term-input input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 var(--space-sm);
    border: var(--rule-hair) solid var(--color-on-night-muted);
    background: var(--color-night-2);
    color: var(--color-on-night);
    font: var(--text-sm)/1 var(--font-outlier);
    caret-color: var(--color-accent);
    outline: 2px solid transparent;
    outline-offset: -3px;
  }
  .term-input input::placeholder { color: var(--color-on-night-muted); }
  .term-input input:focus-visible { outline-color: var(--color-accent); }

  .proof { display: flex; flex-direction: column; gap: var(--space-xl); padding-block: var(--space-2xl); }
  .trust { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm) var(--space-lg); margin: 0; }
  .trust-k { font-size: var(--text-sm); color: var(--color-muted); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-xl); }
  .chip { display: inline-flex; align-items: center; gap: var(--space-xs); font: var(--display-weight) var(--text-lg)/1.2 var(--font-display); }
  .chip img { filter: grayscale(1); }

  .projects { padding-block: var(--section-gap); }
  .projects-inner { display: flex; flex-direction: column; gap: var(--space-2xl); }
  .projects-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-lg) var(--space-xl); }
  .section-head { display: flex; flex-direction: column; gap: var(--space-md); }
  .section-head .lead { color: var(--color-ink-2); }
  .filters { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .filters button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 2px solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: var(--text-md);
    cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .filters button:hover { background: var(--color-paper-3); }
  .filters button:active { background: var(--color-rule); }
  .filters button[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .filters button:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .filters .count { font-size: var(--text-sm); font-variant-numeric: tabular-nums; opacity: 0.75; }
  .index { margin: 0; padding: 0; list-style: none; border-top: 2px solid var(--color-ink); }

  @media (max-width: 40rem) {
    pre { white-space: pre-wrap; overflow-wrap: anywhere; padding-inline: var(--space-md); }
  }
  @media (max-width: 60rem) {
    .hero { min-height: 0; grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); padding-block: var(--space-xl); }
    .repl { min-height: 0; }
  }
</style>
