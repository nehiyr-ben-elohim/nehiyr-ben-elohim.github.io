---
import SiteLayout from '../layouts/SiteLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ShadowButton from '../components/ShadowButton.astro'
import { OWNER } from '../lib/site'
---

<SiteLayout title={`Page introuvable — ${OWNER}`} description="Cette page n’existe pas (ou plus).">
  <SiteHeader variant="project" />
  <main id="top" class="wrap not-found">
    <span class="code">404</span>
    <h1>Page introuvable</h1>
    <p>Cette page n’existe pas (ou plus).</p>
    <ShadowButton href="/" size="lg">retour à l’accueil</ShadowButton>
  </main>
  <SiteFooter />
</SiteLayout>

<style>
  .not-found {
    min-height: 60vh;
    padding-top: clamp(48px, 8vw, 104px);
    padding-bottom: clamp(48px, 8vw, 104px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
  }
  .code { padding: 3px 10px; background: var(--cs-accent); font-family: var(--cs-mono); font-weight: 700; font-size: 14px; }
  h1 { margin: 0; font-family: var(--cs-display); font-weight: 700; font-size: clamp(44px, 6.4vw, 84px); line-height: 1; }
  p { margin: 0 0 12px; font-size: 18px; color: var(--cs-body); }
</style>
