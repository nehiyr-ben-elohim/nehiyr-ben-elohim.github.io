---
import SiteLayout from '../layouts/SiteLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ShadowButton from '../components/ShadowButton.astro'
import { OWNER } from '../lib/site'
---

<SiteLayout title={`Page introuvable — ${OWNER}`} description="Cette page n’existe pas (ou plus).">
  <SiteHeader variant="project" />
  <main id="top" class="container not-found">
    <h1>Erreur 404, page introuvable</h1>
    <p class="lead">Cette page n’existe pas (ou plus). Les projets et le contact sont sur l’accueil.</p>
    <ShadowButton href="/" size="lg">retour à l’accueil</ShadowButton>
  </main>
  <SiteFooter />
</SiteLayout>

<style>
  .not-found { min-height: 64dvh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--space-lg); padding-block: var(--space-3xl); }
  h1 { max-width: 14ch; text-wrap: balance; }
  .lead { color: var(--color-ink-2); }
</style>
