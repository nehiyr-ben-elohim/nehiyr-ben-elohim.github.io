---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FloatingHeader from '../../components/FloatingHeader.astro'
import Blog from '../../components/Blog.astro'
import Contact from '../../components/Contact.astro'
import Foot from '../../components/Foot.astro'
import { getActivities } from '../../lib/collection'

const items = await getActivities()
---

<BaseLayout title="Mini blog — Jean-jacques AKAKPO" description="La frise de mes activités : projets, travaux et articles.">
  <FloatingHeader
    restricted
    colorScheme="light"
    expanded={{
      title: 'I have a --dream blog',
      bg: '/img/bg/blog_bg.webp',
      hints: ['Something like a blog rather', 'Just a list of my stuff', 'Even my hobbies ^^'],
    }}
  />
  <Blog items={items} />
  <Contact bg="/img/bg/blog_footer_bg.webp" stepIndicator={false} />
  <Foot />
</BaseLayout>

<style is:global>
  .contact-row {
    z-index: 99;
    position: relative;
    background: #fff;
  }
</style>
