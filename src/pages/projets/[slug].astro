---
import { Image } from 'astro:assets'
import SiteLayout from '../../layouts/SiteLayout.astro'
import ShadowButton from '../../components/ShadowButton.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import { counter, getCaseStudies, neighbors, sectionId, type CaseStudy } from '../../lib/case-studies'
import { deviconSrc } from '../../lib/devicons'
import { GITHUB_URL, OWNER } from '../../lib/site'
import { resolveImage } from '../../lib/images'

export const getStaticPaths = () => {
  const studies = getCaseStudies()
  return studies.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, index: i, total: studies.length, ...neighbors(studies, i) },
  }))
}

interface Props {
  p: CaseStudy
  index: number
  total: number
  prev: CaseStudy
  next: CaseStudy
}

const { p, index, total, prev, next } = Astro.props
const href = (s: CaseStudy) => `/projets/${s.slug}`
const sections = p.sections.map(s => ({ ...s, id: sectionId(s.n) }))
---

<SiteLayout title={`${p.title} — ${OWNER}`} description={p.lead}>
  <SiteHeader variant="project" />

  <main>
    <section class="wrap intro" id="top">
      <div class="crumbs">
        <span style="white-space:nowrap"><a href="/#projets">projets</a> / {p.slug}</span>
        <span data-counter>{counter(index, total)}</span>
      </div>
      <div class="kicker" data-anim="kicker">
        <span class="kind">{p.kind}</span>
        <span class="period">{p.period}</span>
      </div>
      <h1 data-anim="title">{p.title}</h1>
      <p class="lead" data-anim="lead">{p.lead}</p>
      <div class="actions">
        <ShadowButton href={GITHUB_URL} external>
          <img src="/img/devicons/github.svg" alt="" width="20" height="20" />{p.cta}
        </ShadowButton>
        <a href="#etude" class="read-link">lire l’étude de cas <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="wrap">
      <div class="cs-visual" style={`background:${p.color}`}>
        <div class="shot" data-anim="shot">
          {p.shot ? (
            <Image src={resolveImage(p.shot)} alt={`Capture d’écran — ${p.name}`} widths={[640, 880, 1760]} sizes="(min-width: 960px) 880px, 100vw" />
          ) : (
            <div class="shot-placeholder" aria-hidden="true">{p.name}</div>
          )}
        </div>
        <span class="visual-label">{p.name}</span>
      </div>
      <dl class="cs-meta">
        {p.meta.map(m => (
          <div data-reveal>
            <dt>{m.k}</dt>
            <dd>{m.v}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="etude" class="wrap study">
      <aside class="study-aside">
        <div class="aside-block">
          <span class="aside-title">› sommaire</span>
          <nav class="cs-summary" aria-label="Sommaire">
            {sections.map(s => <a href={`#${s.id}`}>{s.title}</a>)}
          </nav>
        </div>
        <div class="aside-block">
          <span class="aside-title">› stack</span>
          <ul class="cs-stack">
            {p.stack.map(t => (
              <li><img src={deviconSrc(t.icon)} alt="" width="20" height="20" />{t.name}</li>
            ))}
          </ul>
        </div>
      </aside>
      <article class="study-body">
        {sections.map(s => (
          <div data-reveal id={s.id} class="study-section">
            <span class="section-n">{s.n}</span>
            <h2><span class="hl">{s.title}</span></h2>
            <p>{s.body}</p>
            {s.list.length > 0 && (
              <ul>
                {s.list.map(li => <li><span class="bullet" aria-hidden="true">›</span><span>{li}</span></li>)}
              </ul>
            )}
          </div>
        ))}
        <figure data-reveal class="figure">
          <div class="figure-frame">
            {p.shot2 ? (
              <Image src={resolveImage(p.shot2)} alt="" widths={[640, 1280]} sizes="(min-width: 960px) 760px, 100vw" />
            ) : (
              <div class="shot-placeholder muted" aria-hidden="true">{p.name}</div>
            )}
          </div>
          <figcaption>{p.caption}</figcaption>
        </figure>
      </article>
    </section>

    <section class="next-up">
      <div class="wrap next-inner">
        <div class="next-cta">
          <div class="next-copy">
            <span class="next-kicker">› un projet similaire ?</span>
            <span class="next-title">On en parle autour d’un café.</span>
          </div>
          <ShadowButton href="/#contact" size="lg" shadow="#fff">me contacter</ShadowButton>
        </div>
        <nav data-reveal aria-label="Autres projets" class="adjacent">
          <a href={href(prev)} data-prev>
            <span class="adj-label">‹ projet précédent</span>
            <span class="adj-title">{prev.title}</span>
          </a>
          <a href={href(next)} data-next class="adj-next">
            <span class="adj-label">projet suivant ›</span>
            <span class="adj-title">{next.title}</span>
          </a>
        </nav>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>

<style>
  .intro {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(40px, 5vw, 56px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    font-family: var(--cs-mono);
    font-size: 13px;
    color: var(--cs-muted);
  }
  .crumbs a { text-decoration: underline; }
  .kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .kind { padding: 3px 10px; background: var(--cs-accent); font-family: var(--cs-display); font-weight: 700; font-size: 14px; }
  .period { font-family: var(--cs-mono); font-size: 13px; color: #3a3a3a; }
  h1 {
    margin: 0;
    max-width: 18ch;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: clamp(44px, 6.4vw, 84px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .lead {
    margin: 0;
    max-width: 60ch;
    font-size: clamp(18px, 1.8vw, 21px);
    line-height: 1.65;
    color: var(--cs-body);
    text-wrap: pretty;
  }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 22px; padding-top: 4px; }
  .actions img { display: block; }
  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 6px;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: 17px;
    border-bottom: 3px solid var(--cs-ink);
  }
  .read-link:hover { background: var(--cs-accent); }

  .cs-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 4vw, 56px) clamp(20px, 4vw, 56px) clamp(48px, 6vw, 72px);
  }
  .shot {
    position: relative;
    width: min(100%, 880px);
    aspect-ratio: 16 / 9;
    background: #fff;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }
  .shot :global(img), .figure-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .shot-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: clamp(24px, 4vw, 48px);
    color: #d6d6d6;
    background: repeating-linear-gradient(135deg, #fafafa 0 14px, #f3f3f3 14px 28px);
  }
  .shot-placeholder.muted { background: #f0f0f0; }
  .visual-label {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 6px 14px;
    background: var(--cs-ink);
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: #fff;
  }
  .cs-meta {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 20px;
    padding: 26px 0;
    border-bottom: 1px dotted var(--cs-ink);
  }
  .cs-meta div { display: flex; flex-direction: column; gap: 4px; }
  .cs-meta dt {
    font-family: var(--cs-mono);
    font-size: 12px;
    font-weight: 500;
    color: #5a5a5a;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .cs-meta dd { margin: 0; font-family: var(--cs-display); font-weight: 700; font-size: 18px; line-height: 1.3; }

  .study {
    padding-top: clamp(48px, 7vw, 88px);
    padding-bottom: clamp(48px, 7vw, 88px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 72px;
    align-items: flex-start;
  }
  .study-aside {
    flex: 1 1 260px;
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  @media (max-width: 860px) {
    .study-aside { position: static; }
  }
  .aside-block { display: flex; flex-direction: column; gap: 10px; }
  .aside-title { font-family: var(--cs-display); font-weight: 700; font-size: 16px; }
  .cs-summary { display: flex; flex-direction: column; border-left: 4px solid var(--cs-ink); }
  .cs-summary a { padding: 7px 14px; font-family: var(--cs-display); font-weight: 700; font-size: 15px; }
  .cs-summary a:hover { background: var(--cs-accent); }
  .cs-stack { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .cs-stack li {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px 5px 7px;
    border: 1px solid #dcdcdc;
    font-weight: 600;
    font-size: 14px;
  }
  .cs-stack img { display: block; object-fit: contain; }

  .study-body { flex: 2.4 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 48px; }
  .study-section { display: flex; flex-direction: column; gap: 14px; max-width: 68ch; }
  .section-n { font-family: var(--cs-mono); font-size: 13px; font-weight: 700; color: var(--cs-muted); }
  .study-section h2 {
    margin: 0;
    font-family: var(--cs-display);
    font-weight: 700;
    font-size: clamp(26px, 2.8vw, 34px);
    line-height: 1.15;
  }
  .hl { background: linear-gradient(transparent 60%, var(--cs-accent) 60%); padding: 0 2px; }
  .study-section p { margin: 0; font-size: 18px; line-height: 1.75; color: var(--cs-body); text-wrap: pretty; }
  .study-section ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .study-section li { display: flex; gap: 12px; align-items: baseline; font-size: 17px; line-height: 1.6; }
  .bullet { flex: 0 0 auto; font-family: var(--cs-display); font-weight: 700; }
  .figure { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .figure-frame { position: relative; aspect-ratio: 16 / 10; background: #f0f0f0; border: 2px solid var(--cs-ink); overflow: hidden; }
  .figure figcaption { font-size: 14px; color: var(--cs-muted); }

  .next-up { background: var(--cs-ink); color: #fff; }
  .next-inner {
    padding-top: clamp(48px, 7vw, 88px);
    padding-bottom: clamp(48px, 7vw, 88px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .next-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px; }
  .next-copy { display: flex; flex-direction: column; gap: 8px; }
  .next-kicker { font-family: var(--cs-display); font-weight: 700; font-size: 16px; color: var(--cs-accent); }
  .next-title { font-family: var(--cs-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.1; }
  .adjacent {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1px;
    background: #3a3a3a;
    border: 1px solid #3a3a3a;
  }
  .adjacent a {
    background: var(--cs-ink);
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: #fff;
  }
  .adjacent a:hover { background: #1d1d1d; color: #fff; }
  .adjacent .adj-next { align-items: flex-end; text-align: right; }
  .adj-label {
    font-family: var(--cs-mono);
    font-size: 12px;
    color: #cfcfcf;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .adj-title { font-family: var(--cs-display); font-weight: 700; font-size: 24px; }
</style>
