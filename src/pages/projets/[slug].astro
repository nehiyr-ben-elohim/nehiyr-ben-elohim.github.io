---
import { getImage, Image } from 'astro:assets'
import SiteLayout from '../../layouts/SiteLayout.astro'
import ShadowButton from '../../components/ShadowButton.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import CaseStudyArchi from '../../components/CaseStudyArchi.astro'
import CaseStudyGallery from '../../components/CaseStudyGallery.astro'
import { counter, getCaseStudies, hasGallery, neighbors, sectionId, toc, type CaseStudy } from '../../lib/case-studies'
import { deviconSrc } from '../../lib/devicons'
import { OWNER } from '../../lib/site'
import { resolveImage } from '../../lib/images'

export const getStaticPaths = () => {
  const studies = getCaseStudies()
  return studies.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, index: i, total: studies.length, ...neighbors(studies, i) },
  }))
}

interface Props {
  p: CaseStudy
  index: number
  total: number
  prev: CaseStudy
  next: CaseStudy
}

const { p, index, total, prev, next } = Astro.props
const href = (s: CaseStudy) => `/projets/${s.slug}`
const sections = p.sections.map(s => ({ ...s, id: sectionId(s.n) }))
const tocEntries = toc(p)
const TLDR = [['Problème', p.tldr.problem], ['Solution', p.tldr.solution], ['Résultat', p.tldr.result]]
// frame bar: real URL only, "confidentiel" under NDA, nothing otherwise
const shotUrl = p.url ? new URL(p.url).host : p.nda ? 'confidentiel' : undefined
const shotLarge = p.shot ? (await getImage({ src: resolveImage(p.shot), width: 1600 })).src : undefined
const pager = [
  { s: prev, label: 'Projet précédent', arrow: '←', attr: { 'data-prev': '' } },
  { s: next, label: 'Projet suivant', arrow: '→', attr: { 'data-next': '' } },
]
---

<SiteLayout title={`${p.title} — ${OWNER}`} description={p.lead} progress>
  <SiteHeader variant="project" />

  <main>
    <section class="intro" id="top" data-section="projet">
      <div class="container intro-inner">
        <p class="crumbs">
          <span class="nowrap"><a href="/#projets">projets</a> / {p.slug}</span>
          <span><span data-counter>{counter(index, total)}</span><span class="kbd-hint"> · ← → pour naviguer</span></span>
        </p>
        <h1 data-anim="title">{p.title}</h1>
        <p class="lead" data-anim="lead">{p.lead}</p>
        <p class="meta" data-anim="kicker"><span class="kind">{p.kind.replace(/ · /g, ', ')}</span><time>{p.period}</time></p>
        <div class="actions">
          {p.code && (
            <ShadowButton href={p.code} external>
              <img src="/img/devicons/github.svg" alt="" width="20" height="20" />voir le code
            </ShadowButton>
          )}
          {p.nda && <p class="nda" data-nda title="Projet client sous accord de confidentialité">code client confidentiel · NDA</p>}
          <a href="#etude" class="text-link">lire l’étude de cas</a>
        </div>
      </div>
    </section>

    <section class="cs-visual on-night" style={`background:${p.color}`} aria-label="Résultats">
      <div class="container visual-inner">
        <dl class="metrics">
          {p.metrics.map(m => (
            <div data-fact>
              <dt>{m.k}</dt>
              <dd><span>{m.pre}<span data-count={m.n}>{m.n}</span>{m.suf}</span></dd>
            </div>
          ))}
        </dl>
        {p.shot && (
          <figure class="shot" data-anim="shot">
            <Image src={resolveImage(p.shot)} alt={`Capture d’écran — ${p.name}`} widths={[640, 900, 1800]} sizes="(min-width: 980px) 900px, 100vw" />
            {shotLarge && (
              <button type="button" class="zoom" data-zoom={shotLarge} data-zoom-cap={p.name} aria-label="Agrandir la capture">agrandir</button>
            )}
          </figure>
        )}
        {shotUrl && <p class="shot-caption">{p.shot ? 'Capture' : 'Pas de capture publique'} : <span data-shot-url>{shotUrl}</span></p>}
      </div>
    </section>

    <section class="brief" aria-label="En bref">
      <div class="container brief-inner">
        <div data-reveal class="tldr">
          <h2 class="brief-title">En bref</h2>
          <dl>
            {TLDR.map(([k, v]) => (
              <div><dt>{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        </div>
        <dl class="cs-meta">
          {p.meta.map(m => (
            <div data-reveal>
              <dt>{m.k}</dt>
              <dd>{m.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="etude" class="study" data-section="étude de cas">
      <div class="container study-inner">
        <aside class="study-aside">
          <nav class="cs-summary" aria-label="Sommaire">
            <h2 class="aside-title">Sommaire</h2>
            {tocEntries.map(t => <a href={`#${t.id}`}><span class="toc-n">{t.n}</span>{t.title}</a>)}
          </nav>
          <div class="aside-block">
            <h2 class="aside-title">Stack et rôle</h2>
            <ul class="cs-stack">
              {p.stack.map(t => (
                <li>
                  <span class="stack-icon">{t.icon ? <img src={deviconSrc(t.icon)} alt="" width="20" height="20" /> : <span class="stack-abbr" aria-hidden="true">{t.name.slice(0, 3)}</span>}</span>
                  <span class="stack-text"><span class="stack-name">{t.name}</span><span class="stack-role">{t.role}</span></span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
        <article class="study-body">
          {sections.map(s => (
            <div data-reveal data-spy id={s.id} class="study-section">
              <h2>{s.title}</h2>
              <p>{s.body}</p>
              {s.list.length > 0 && (
                <ul>
                  {s.list.map(li => <li>{li}</li>)}
                </ul>
              )}
            </div>
          ))}
        </article>
      </div>
    </section>

    <CaseStudyArchi archi={p.archi} snippet={p.snippet} />

    {hasGallery(p) && <CaseStudyGallery gallery={p.gallery} />}

    {p.quote && (
      <section id="avis" data-spy data-section="témoignage" class="quote">
        <figure data-reveal class="container quote-inner">
          <blockquote>« {p.quote.text} »</blockquote>
          <figcaption class="quote-who">
            <span class="who">{p.quote.who}</span>
            <span class="who-role">{p.quote.role}</span>
          </figcaption>
        </figure>
      </section>
    )}

    <section id="suite" class="next-up on-night" data-section="la suite">
      <div class="container next-inner">
        <div class="next-cta">
          <h2 class="next-title">Un projet similaire ? On en parle autour d’un café.</h2>
          <ShadowButton href="/#contact" size="lg">me contacter</ShadowButton>
        </div>
        <nav data-reveal aria-label="Autres projets" class="pager">
          {pager.map(n => (
            <a href={href(n.s)} {...n.attr}>
              <span class="pager-arrow" style={`background:${n.s.color}`} aria-hidden="true">{n.arrow}</span>
              <span class="pager-text">
                <span class="pager-label">{n.label}</span>
                <span class="pager-title">{n.s.title}</span>
                <span class="pager-kind">{n.s.kind}</span>
              </span>
            </a>
          ))}
        </nav>
      </div>
    </section>
  </main>

  <SiteFooter />

  {(shotLarge || hasGallery(p)) && (
    <dialog class="zoom-dialog" data-zoom-dialog aria-label="Capture agrandie">
      <div class="zoom-frame"><img alt="" /></div>
      <div class="zoom-foot">
        <span data-zoom-cap></span>
        <button type="button" data-zoom-close>fermer</button>
      </div>
    </dialog>
  )}
</SiteLayout>

<style>
  .nowrap { white-space: nowrap; }
  .intro-inner { min-height: 52dvh; display: flex; flex-direction: column; justify-content: flex-end; gap: var(--space-lg); padding-block: var(--space-2xl) var(--space-3xl); }
  .crumbs { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-xs) var(--space-lg); font-size: var(--text-sm); color: var(--color-muted); }
  .crumbs a { color: var(--color-ink); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-md); font-size: var(--text-sm); color: var(--color-muted); }
  .kind { padding: 0 var(--space-xs); background: var(--color-accent); color: var(--color-ink); }
  h1 { max-width: 16ch; font-size: var(--text-display); text-wrap: balance; }
  .intro .lead { max-width: 56ch; color: var(--color-ink-2); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-xl); }
  .nda { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-md); border: 2px dashed var(--color-ink); font-size: var(--text-sm); }

  .visual-inner { display: flex; flex-direction: column; gap: var(--space-xl); padding-block: var(--space-3xl) var(--space-xl); }
  .metrics { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .metrics div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-sm); padding: 0 var(--space-lg); border-left: var(--rule-hair) solid currentColor; }
  .metrics div:first-child { padding-left: 0; border-left: 0; }
  .metrics dd { margin: 0; font: var(--display-weight) clamp(3.5rem, 5vw + 1rem, 6.5rem)/1 var(--font-display); letter-spacing: var(--tracking-display); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .metrics dt { max-width: 28ch; font-size: var(--text-lg); }
  .shot { position: relative; margin: 0; }
  .shot :global(img) { width: 100%; height: auto; }
  .zoom { position: absolute; right: var(--space-md); bottom: var(--space-md); min-height: 44px; padding: 0 var(--space-md); border: 2px solid var(--color-ink); background: var(--color-paper); color: var(--color-ink); cursor: pointer; }
  .zoom:hover { background: var(--color-accent); }
  .zoom:active { background: var(--color-paper-3); }
  .shot-caption { padding-top: var(--space-md); border-top: var(--rule-hair) solid currentColor; font-size: var(--text-sm); }

  .brief-inner { padding-block: var(--section-gap-s); display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--space-2xl) var(--gap-columns); align-items: start; }
  .tldr { display: flex; flex-direction: column; gap: var(--space-lg); }
  .brief-title { font-size: var(--text-section); }
  .aside-title { font-size: var(--text-title); }
  .tldr dl { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid var(--color-ink); }
  .tldr dl div { display: flex; flex-direction: column; gap: var(--space-xs); padding: var(--space-md) var(--space-lg) 0; border-left: var(--rule-hair) solid var(--color-rule); }
  .tldr dl div:first-child { padding-left: 0; border-left: 0; }
  .tldr dt { font-weight: 700; }
  .tldr dd { margin: 0; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; }
  .cs-meta { margin: 0; border-top: 2px solid var(--color-ink); }
  .cs-meta div { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-md); padding-block: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .cs-meta dt { font-size: var(--text-sm); color: var(--color-muted); }
  .cs-meta dd { margin: 0; font-weight: 700; }

  .study { border-top: var(--rule-hair) solid var(--color-ink); }
  .study-inner { padding-block: var(--section-gap); display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-2xl) var(--gap-columns); align-items: start; }
  .study-aside { position: sticky; top: var(--space-3xl); display: flex; flex-direction: column; gap: var(--space-xl); }
  .cs-summary { display: flex; flex-direction: column; }
  .cs-summary .aside-title { margin-bottom: var(--space-sm); }
  .cs-summary a {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    min-height: 44px;
    padding: var(--space-xs) var(--space-sm);
    border-left: 2px solid var(--color-rule);
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .cs-summary a:hover { background: var(--color-paper-3); }
  .cs-summary a[aria-current='true'] { border-left-color: var(--color-ink); background: var(--color-accent); }
  .toc-n { font-size: var(--text-sm); color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .aside-block { display: flex; flex-direction: column; gap: var(--space-sm); }
  .cs-stack { margin: 0; padding: 0; list-style: none; border-top: var(--rule-hair) solid var(--color-ink); }
  .cs-stack li { display: flex; align-items: center; gap: var(--space-sm); padding-block: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .stack-icon { flex-shrink: 0; width: 32px; height: 32px; display: grid; place-items: center; }
  .stack-abbr { font-size: var(--text-sm); font-weight: 700; }
  .stack-text { display: flex; flex-direction: column; }
  .stack-name { font-weight: 700; }
  .stack-role { font-size: var(--text-sm); color: var(--color-muted); }
  .study-body { display: flex; flex-direction: column; gap: var(--space-3xl); }
  .study-section { display: flex; flex-direction: column; gap: var(--space-md); scroll-margin-top: var(--space-3xl); }
  .study-section h2 { font-size: var(--text-section); text-wrap: balance; }
  .study-section p { color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.6; }
  .study-section ul { margin: 0; padding: 0 0 0 var(--space-lg); display: flex; flex-direction: column; gap: var(--space-xs); }
  .study-section li { max-width: 65ch; }
  .study-section li::marker { color: var(--color-muted); }

  .quote { background: var(--color-paper-2); }
  .quote-inner { margin-block: 0; padding-block: var(--section-gap); display: flex; flex-direction: column; gap: var(--space-lg); }
  blockquote { margin: 0; max-width: 30ch; font: var(--display-weight) var(--text-section)/1.15 var(--font-display); }
  .quote-who { display: flex; flex-direction: column; }
  .who { font-weight: 700; }
  .who-role { font-size: var(--text-sm); color: var(--color-muted); }

  .next-inner { padding-block: var(--section-gap-s); display: flex; flex-direction: column; gap: var(--space-2xl); }
  .next-cta { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-lg) var(--space-2xl); }
  .next-title { max-width: 22ch; font-size: var(--text-section); text-wrap: balance; }
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap-columns); }
  .pager a {
    display: flex;
    align-items: stretch;
    border: var(--rule-hair) solid var(--color-night-rule);
    text-decoration: none;
    transition: border-color var(--dur-short) var(--ease-out);
  }
  .pager a:hover { border-color: var(--color-accent); }
  .pager a:active { border-color: var(--color-on-night-muted); }
  .pager-arrow { flex-shrink: 0; width: 72px; display: grid; place-items: center; font: var(--display-weight) var(--text-xl)/1 var(--font-display); color: var(--color-on-night); }
  .pager-text { min-width: 0; display: flex; flex-direction: column; gap: var(--space-2xs); padding: var(--space-md) var(--space-lg); }
  .pager-label { font-size: var(--text-sm); color: var(--color-on-night-muted); }
  .pager-title { font: var(--display-weight) var(--text-title)/1.2 var(--font-display); }
  .pager-kind { font-size: var(--text-sm); color: var(--color-on-night-2); }

  .zoom-dialog { width: min(1200px, 100% - 2 * var(--gutter)); padding: 0; border: 2px solid var(--color-ink); background: var(--color-paper); }
  .zoom-dialog::backdrop { background: color-mix(in oklab, var(--color-ink) 80%, transparent); }
  .zoom-frame img { width: 100%; height: auto; }
  .zoom-foot { display: flex; justify-content: space-between; align-items: center; gap: var(--space-md); padding: var(--space-sm) var(--space-md); font-size: var(--text-sm); }
  .zoom-foot button { min-height: 44px; padding: 0 var(--space-md); border: 2px solid var(--color-ink); background: var(--color-paper); color: var(--color-ink); cursor: pointer; }
  .zoom-foot button:hover { background: var(--color-accent); }
  .zoom-foot button:active { background: var(--color-paper-3); }

  @media (max-width: 60rem) {
    .intro-inner { min-height: 0; }
    .metrics, .tldr dl, .pager { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    .metrics div, .metrics div:first-child, .tldr dl div, .tldr dl div:first-child { padding: 0; border-left: 0; }
    .brief-inner, .study-inner { grid-template-columns: minmax(0, 1fr); }
    .study-aside { position: static; }
  }
  @media (max-width: 40rem) {
    .kbd-hint { display: none; }
  }
</style>
